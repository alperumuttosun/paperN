# =========================================================
# negatifstep1.R
# Negative Transfer pilot - Step 1: data preparation and
# selection of target / pool / candidate countries
# Runs for ALL crops (wheat, barley, oats, rye, rice,
# maize, soybean, sorghum)
# =========================================================

library(readxl)    # to read xlsx input files
library(openxlsx)  # to write xlsx output files
library(dplyr)      # data manipulation

set.seed(42)   # fixes all randomness so results are reproducible

# ---- 0. Folder paths ----
data_dir <- "C:/Users/Alper.Tosun/Desktop/cru130"             # folder containing all panelv7_<crop>.xlsx files
proj_dir <- file.path(data_dir, "negatif_transfer")           # subfolder where this pilot's outputs are saved
if (!dir.exists(proj_dir)) {
  dir.create(proj_dir, recursive = TRUE)   # create the folder if it doesn't exist yet
  cat("Folder created:", proj_dir, "\n")
}

# ---- Crop color palette (fixed now for later plots) ----
crop_colors <- c(
  wheat   = "#08519C",
  barley  = "#3182BD",
  oats    = "#6BAED6",
  rye     = "#9ECAE1",
  rice    = "#A63603",
  maize   = "#E6550D",
  soybean = "#FD8D3C",
  sorghum = "#FDBE85"
)
crop_colors_df <- data.frame(crop = names(crop_colors), color = unname(crop_colors))  # turn palette into a table for saving

crops <- names(crop_colors)   # the 8 crops to process

# ---- Function that runs step-1 selection for a single crop ----
process_crop <- function(crop_name) {
  
  file_path <- file.path(data_dir, paste0("panelv7_", crop_name, ".xlsx"))  # e.g. panelv7_wheat.xlsx
  
  if (!file.exists(file_path)) {
    cat("WARNING:", file_path, "not found, skipping this crop.\n")
    return(NULL)
  }
  
  cat("\n----", toupper(crop_name), "----\n")
  
  df <- read_excel(file_path)   # raw country-year panel
  
  # ---- Apply minimum observation threshold (>=30) ----
  obs_count <- df %>%
    group_by(Country_ISO) %>%
    summarise(n_obs = sum(!is.na(yield_hg_per_ha)), .groups = "drop")   # valid observation count per country
  
  eligible_countries <- obs_count %>%
    filter(n_obs >= 30) %>%       # threshold: 30 observations
    pull(Country_ISO)
  
  cat("Eligible countries (>=30 obs):", length(eligible_countries), "\n")
  
  df_elig <- df %>% filter(Country_ISO %in% eligible_countries)   # keep only eligible countries
  
  # ---- Build climate fingerprint (one row per country) ----
  fingerprint <- df_elig %>%
    group_by(Country_ISO) %>%
    summarise(
      mean_TMX = mean(TMX_ann, na.rm = TRUE),         # mean max temperature
      sd_TMX   = sd(TMX_ann,   na.rm = TRUE),         # temperature variability
      mean_PRE = mean(PRE_ann, na.rm = TRUE),         # mean precipitation
      sd_PRE   = sd(PRE_ann,   na.rm = TRUE),         # precipitation variability
      mean_GDP = mean(GDP_per_Capita, na.rm = TRUE),  # mean GDP per capita
      .groups = "drop"
    ) %>%
    filter(complete.cases(.))   # drop countries with any missing fingerprint value
  
  cat("Countries with a fingerprint:", nrow(fingerprint), "\n")
  
  # ---- K-means: pick 5 target countries (closest country to each cluster centroid) ----
  fp_scaled <- scale(fingerprint[, c("mean_TMX","sd_TMX","mean_PRE","sd_PRE","mean_GDP")])  # standardize (units differ)
  km <- kmeans(fp_scaled, centers = 5, nstart = 25)   # 5 climate clusters, best of 25 random starts
  
  target_countries <- character(5)
  for (k in 1:5) {
    idx_in_cluster <- which(km$cluster == k)                       # row indices of countries in this cluster
    centroid <- km$centers[k, ]                                    # cluster centroid
    dists <- apply(fp_scaled[idx_in_cluster, , drop = FALSE], 1,
                   function(row) sqrt(sum((row - centroid)^2)))    # Euclidean distance to centroid
    closest <- idx_in_cluster[which.min(dists)]                    # country closest to the centroid
    target_countries[k] <- fingerprint$Country_ISO[closest]
  }
  
  cat("Selected 5 target countries:", paste(target_countries, collapse = ", "), "\n")
  
  # ---- Fixed source pool S (N=20) - stratified random sample from non-target countries ----
  pool_candidates_fp <- fingerprint %>% filter(!Country_ISO %in% target_countries)
  pool_clusters <- km$cluster[match(pool_candidates_fp$Country_ISO, fingerprint$Country_ISO)]
  
  pool_countries <- character(0)
  n_per_cluster <- round(20 * table(pool_clusters) / length(pool_clusters))   # proportional allocation per cluster
  
  for (k in unique(pool_clusters)) {
    cluster_pool <- pool_candidates_fp$Country_ISO[pool_clusters == k]
    n_take <- min(n_per_cluster[as.character(k)], length(cluster_pool))
    pool_countries <- c(pool_countries, sample(cluster_pool, n_take))   # reproducible thanks to seed=42
  }
  
  # fix rounding errors so the pool is exactly 20 countries
  if (length(pool_countries) > 20) {
    pool_countries <- sample(pool_countries, 20)
  } else if (length(pool_countries) < 20) {
    remaining <- setdiff(pool_candidates_fp$Country_ISO, pool_countries)
    extra <- sample(remaining, 20 - length(pool_countries))
    pool_countries <- c(pool_countries, extra)
  }
  
  cat("Fixed source pool (N=20):", paste(pool_countries, collapse = ", "), "\n")
  
  # ---- Candidate source countries: everyone outside pool + target ----
  candidate_countries <- fingerprint$Country_ISO[
    !fingerprint$Country_ISO %in% c(target_countries, pool_countries)
  ]
  
  cat("Number of candidate source countries:", length(candidate_countries), "\n")
  
  # ---- Build small summary tables for this crop (to be combined across crops later) ----
  selection_tbl <- bind_rows(
    data.frame(crop = crop_name, country = target_countries,    role = "target"),
    data.frame(crop = crop_name, country = pool_countries,      role = "pool"),
    data.frame(crop = crop_name, country = candidate_countries, role = "candidate")
  )
  
  fingerprint_tbl <- fingerprint %>% mutate(crop = crop_name, .before = 1)   # add crop column for stacking
  
  list(selection = selection_tbl, fingerprint = fingerprint_tbl)
}

# ---- Process all crops ----
results_by_crop <- lapply(crops, process_crop)
names(results_by_crop) <- crops
results_by_crop <- results_by_crop[!sapply(results_by_crop, is.null)]   # drop crops whose file was missing

cat("\nCrops processed:", length(results_by_crop), "/", length(crops), "\n")

# ---- Combine results across crops into two flat tables ----
selection_all   <- bind_rows(lapply(results_by_crop, `[[`, "selection"))
fingerprint_all <- bind_rows(lapply(results_by_crop, `[[`, "fingerprint"))

# ---- Save everything as a single Excel workbook (no RDS) ----
# Step 2 will re-read the raw panelv7_<crop>.xlsx files itself and just
# use these tables to know which country plays which role, per crop.
out_path <- file.path(proj_dir, "negstep1_output.xlsx")

wb <- createWorkbook()
addWorksheet(wb, "selection")     # crop, country, role (target/pool/candidate)
addWorksheet(wb, "fingerprint")   # crop, country, climate/GDP fingerprint
addWorksheet(wb, "crop_colors")   # crop -> hex color, for later plots

writeData(wb, "selection", selection_all)
writeData(wb, "fingerprint", fingerprint_all)
writeData(wb, "crop_colors", crop_colors_df)

saveWorkbook(wb, out_path, overwrite = TRUE)

cat("\nStep 1 complete. Output saved to:\n", out_path, "\n")













# =========================================================
# negatifstep2.R
# Negative Transfer pilot - Step 2: train models, compute
# NT(s|S,t) for every (target, candidate) pair, and test
# whether distance-based predictors track NT.
# Runs for every crop found in negstep1_output.xlsx
# =========================================================

library(readxl)    # read xlsx input
library(openxlsx)  # write xlsx output
library(dplyr)      # data manipulation
library(glmnet)     # LASSO
library(xgboost)    # XGBoost

set.seed(42)   # reproducibility

# ---- 0. Folder paths (same convention as step 1) ----
data_dir <- "C:/Users/Alper.Tosun/Desktop/cru130"
proj_dir <- file.path(data_dir, "negatif_transfer")

# ---- 1. Load step-1 output ----
step1_path <- file.path(proj_dir, "negstep1_output.xlsx")
selection   <- read_excel(step1_path, sheet = "selection")     # crop, country, role
fingerprint <- read_excel(step1_path, sheet = "fingerprint")   # crop, country, climate/GDP fingerprint

crops_available <- unique(selection$crop)   # crops that step 1 actually produced
cat("Crops found in step-1 output:", paste(crops_available, collapse = ", "), "\n")

# features used to predict yield
feature_cols <- c("TMX_ann", "TMN_ann", "DTR_ann", "PRE_ann", "PET_ann", "CO2_ppm", "GDP_per_Capita")

# ---- Function: fit LASSO on train_df, return RMSE on test_df ----
fit_lasso_rmse <- function(train_df, test_df) {
  x_train <- as.matrix(train_df[, feature_cols])         # predictor matrix
  y_train <- log(train_df$yield_hg_per_ha)                # log-yield as response (stabilizes variance)
  x_test  <- as.matrix(test_df[, feature_cols])
  y_test  <- log(test_df$yield_hg_per_ha)
  
  cvfit <- cv.glmnet(x_train, y_train, alpha = 1, nfolds = 5)   # alpha=1 -> LASSO, pick lambda by 5-fold CV
  pred  <- predict(cvfit, newx = x_test, s = "lambda.min")       # predict at the best lambda
  
  sqrt(mean((exp(pred) - exp(y_test))^2))   # RMSE back on the original yield scale
}

# ---- Function: fit XGBoost on train_df, return RMSE on test_df ----
fit_xgb_rmse <- function(train_df, test_df) {
  x_train <- as.matrix(train_df[, feature_cols])
  y_train <- log(train_df$yield_hg_per_ha)
  x_test  <- as.matrix(test_df[, feature_cols])
  y_test  <- log(test_df$yield_hg_per_ha)
  
  model <- xgboost(x = x_train, y = y_train, nrounds = 100, max_depth = 4,
                   learning_rate = 0.1, objective = "reg:squarederror")   # new xgboost R API (>=2.0): x/y instead of DMatrix
  pred <- predict(model, x_test)
  
  sqrt(mean((exp(pred) - exp(y_test))^2))
}

# ---- Function: Mahalanobis distance between two countries' fingerprints ----
mahalanobis_dist <- function(fp_mat, cov_inv, country_a, country_b) {
  diff_vec <- fp_mat[country_a, ] - fp_mat[country_b, ]
  sqrt(as.numeric(t(diff_vec) %*% cov_inv %*% diff_vec))
}

# ---- Process a single crop: compute NT for every (target, candidate) pair ----
process_crop_step2 <- function(crop_name) {
  
  cat("\n----", toupper(crop_name), "----\n")
  
  file_path <- file.path(data_dir, paste0("panelv7_", crop_name, ".xlsx"))
  df <- read_excel(file_path) %>%
    filter(complete.cases(select(., all_of(c("yield_hg_per_ha", feature_cols)))))   # drop rows with missing features
  
  sel_crop <- selection %>% filter(crop == crop_name)
  target_countries    <- sel_crop$country[sel_crop$role == "target"]
  pool_countries      <- sel_crop$country[sel_crop$role == "pool"]
  candidate_countries <- sel_crop$country[sel_crop$role == "candidate"]
  
  # fingerprint matrix for Mahalanobis distance (one row per country)
  fp_crop <- fingerprint %>% filter(crop == crop_name)
  fp_mat  <- as.matrix(fp_crop[, c("mean_TMX","sd_TMX","mean_PRE","sd_PRE","mean_GDP")])
  rownames(fp_mat) <- fp_crop$Country_ISO
  cov_inv <- solve(cov(fp_mat))   # inverse covariance, shared across all distance calculations for this crop
  
  pool_data <- df %>% filter(Country_ISO %in% pool_countries)   # fixed pool S training data (reused for every target)
  
  results <- list()   # collect one row per (target, candidate, model)
  
  for (t in target_countries) {
    
    test_data <- df %>% filter(Country_ISO == t)
    if (nrow(test_data) < 5) next   # too few rows to evaluate reliably, skip this target
    
    # ---- baseline: train on S only ----
    rmse_base_lasso <- fit_lasso_rmse(pool_data, test_data)
    rmse_base_xgb   <- fit_xgb_rmse(pool_data, test_data)
    
    for (s in candidate_countries) {
      
      cand_data <- df %>% filter(Country_ISO == s)
      if (nrow(cand_data) < 5) next   # skip candidates with too little data
      
      train_plus_s <- bind_rows(pool_data, cand_data)   # S union {s}
      
      rmse_add_lasso <- fit_lasso_rmse(train_plus_s, test_data)
      rmse_add_xgb   <- fit_xgb_rmse(train_plus_s, test_data)
      
      d_st <- mahalanobis_dist(fp_mat, cov_inv, s, t)   # simple pairwise distance predictor
      
      results[[length(results) + 1]] <- data.frame(
        crop      = crop_name,
        target    = t,
        candidate = s,
        D_mahalanobis = d_st,
        NT_lasso  = rmse_base_lasso - rmse_add_lasso,   # positive = candidate helped, negative = negative transfer
        NT_xgb    = rmse_base_xgb   - rmse_add_xgb
      )
    }
    cat("  target", t, "done (", length(candidate_countries), "candidates )\n")
  }
  
  bind_rows(results)
}

# ---- Run step 2 for every crop ----
all_results <- bind_rows(lapply(crops_available, process_crop_step2))

cat("\nTotal (target, candidate) pairs evaluated:", nrow(all_results), "\n")

# ---- Summary: does distance predict NT? (Spearman correlation, per crop and model) ----
summary_tbl <- all_results %>%
  group_by(crop) %>%
  summarise(
    n_pairs                 = n(),
    pct_negative_NT_lasso    = mean(NT_lasso < 0) * 100,          # share of pairs that are negative transfer (LASSO)
    pct_negative_NT_xgb      = mean(NT_xgb   < 0) * 100,          # same, for XGBoost
    spearman_D_vs_NT_lasso   = cor(D_mahalanobis, NT_lasso, method = "spearman"),
    spearman_D_vs_NT_xgb     = cor(D_mahalanobis, NT_xgb,   method = "spearman"),
    .groups = "drop"
  )

print(summary_tbl)

# ---- Save everything as Excel (no RDS) ----
out_path <- file.path(proj_dir, "negstep2_output.xlsx")

wb <- createWorkbook()
addWorksheet(wb, "pairwise_results")   # every (target, candidate) row with NT and distance
addWorksheet(wb, "summary_by_crop")    # per-crop Spearman correlation + % negative transfer

writeData(wb, "pairwise_results", all_results)
writeData(wb, "summary_by_crop", summary_tbl)

saveWorkbook(wb, out_path, overwrite = TRUE)

cat("\nStep 2 complete. Output saved to:\n", out_path, "\n")














