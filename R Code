# ---- Function: Mahalanobis distance between two countries' fingerprints ----
mahalanobis_dist <- function(fp_mat, cov_inv, country_a, country_b) {
  diff_vec <- fp_mat[country_a, ] - fp_mat[country_b, ]
  sqrt(as.numeric(t(diff_vec) %*% cov_inv %*% diff_vec))
}

# ---- Build the richer fingerprint + D / D_pool / raw diffs for one crop ----
build_rich_features <- function(crop_name) {
  
  cat("\n----", toupper(crop_name), "----\n")
  
  file_path <- file.path(data_dir, paste0("panelv7_", crop_name, ".xlsx"))
  if (!file.exists(file_path)) {
    cat("WARNING:", file_path, "not found, skipping this crop.\n")
    return(NULL)
  }
  df <- read_excel(file_path)
  
  sel_crop <- selection %>% filter(crop == crop_name)
  all_countries    <- sel_crop$country                              # target + pool + candidate, same set step 1 used
  target_countries <- sel_crop$country[sel_crop$role == "target"]
  pool_countries    <- sel_crop$country[sel_crop$role == "pool"]
  
  # ---- richer fingerprint: mean of every rich_var, plus sd of TMX/PRE like before ----
  fingerprint <- df %>%
    filter(Country_ISO %in% all_countries) %>%
    group_by(Country_ISO) %>%
    summarise(
      across(all_of(rich_vars), ~ mean(.x, na.rm = TRUE), .names = "mean_{.col}"),  # mean of each rich variable
      sd_TMX_ann = sd(TMX_ann, na.rm = TRUE),                                       # keep temperature variability
      sd_PRE_ann = sd(PRE_ann, na.rm = TRUE),                                       # keep precipitation variability
      .groups = "drop"
    ) %>%
    filter(complete.cases(.))   # drop countries with any missing value in the richer set
  
  cat("Countries with a complete rich fingerprint:", nrow(fingerprint), "/", length(all_countries), "\n")
  
  fp_cols <- setdiff(names(fingerprint), "Country_ISO")
  fp_mat  <- as.matrix(fingerprint[, fp_cols])
  rownames(fp_mat) <- fingerprint$Country_ISO
  fp_scaled <- scale(fp_mat)                       # standardize before computing distances (units differ a lot)
  rownames(fp_scaled) <- fingerprint$Country_ISO
  cov_inv <- solve(cov(fp_scaled))
  
  # keep only pool countries that survived the completeness filter
  pool_ok <- intersect(pool_countries, rownames(fp_scaled))
  
  out <- list()
  
  for (t in intersect(target_countries, rownames(fp_scaled))) {
    
    dist_S_to_t <- sapply(pool_ok, function(p) mahalanobis_dist(fp_scaled, cov_inv, p, t))
    avg_dist_S  <- mean(dist_S_to_t)
    
    candidates_ok <- intersect(sel_crop$country[sel_crop$role == "candidate"], rownames(fp_scaled))
    
    for (s in candidates_ok) {
      
      dist_s_to_t <- mahalanobis_dist(fp_scaled, cov_inv, s, t)
      avg_dist_Ss <- (sum(dist_S_to_t) + dist_s_to_t) / (length(pool_ok) + 1)
      
      out[[length(out) + 1]] <- data.frame(
        crop        = crop_name,
        target      = t,
        candidate   = s,
        D_rich      = dist_s_to_t,               # pairwise Mahalanobis distance in the richer feature space
        D_pool_rich = avg_dist_Ss - avg_dist_S,   # pool-aware version, same logic as step 3
        diff_TMX    = fp_mat[s, "mean_TMX_ann"] - fp_mat[t, "mean_TMX_ann"],
        diff_PRE    = fp_mat[s, "mean_PRE_ann"] - fp_mat[t, "mean_PRE_ann"],
        diff_GDP    = fp_mat[s, "mean_GDP_per_Capita"] - fp_mat[t, "mean_GDP_per_Capita"],
        diff_irr    = fp_mat[s, "mean_irr_ratio"] - fp_mat[t, "mean_irr_ratio"],
        diff_AI     = fp_mat[s, "mean_AI"] - fp_mat[t, "mean_AI"],
        diff_PET    = fp_mat[s, "mean_PET_ann"] - fp_mat[t, "mean_PET_ann"],
        diff_DTR    = fp_mat[s, "mean_DTR_ann"] - fp_mat[t, "mean_DTR_ann"]
      )
    }
  }
  
  bind_rows(out)
}

