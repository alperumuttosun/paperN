# maize, soybean, sorghum)
# =========================================================

library(readxl)    # to read xlsx input files
library(openxlsx)  # to write xlsx output files
library(dplyr)      # data manipulation

set.seed(42)   # fixes all randomness so results are reproducible

# ---- 0. Folder paths ----
data_dir <- "C:/Users/Alper.Tosun/Desktop/cru130"             # folder containing all panelv7_<crop>.xlsx files
proj_dir <- file.path(data_dir, "negatif_transfer")           # subfolder where this pilot's outputs are saved
if (!dir.exists(proj_dir)) {
  dir.create(proj_dir, recursive = TRUE)   # create the folder if it doesn't exist yet
  cat("Folder created:", proj_dir, "\n")
}

# ---- Crop color palette (fixed now for later plots) ----
crop_colors <- c(
  wheat   = "#08519C",
  barley  = "#3182BD",
  oats    = "#6BAED6",
  rye     = "#9ECAE1",
  rice    = "#A63603",
  maize   = "#E6550D",
  soybean = "#FD8D3C",
  sorghum = "#FDBE85"
)
crop_colors_df <- data.frame(crop = names(crop_colors), color = unname(crop_colors))  # turn palette into a table for saving

crops <- names(crop_colors)   # the 8 crops to process

# ---- Function that runs step-1 selection for a single crop ----
process_crop <- function(crop_name) {
  
  file_path <- file.path(data_dir, paste0("panelv7_", crop_name, ".xlsx"))  # e.g. panelv7_wheat.xlsx
  
  if (!file.exists(file_path)) {
    cat("WARNING:", file_path, "not found, skipping this crop.\n")
    return(NULL)
  }
  
  cat("\n----", toupper(crop_name), "----\n")
  
  df <- read_excel(file_path)   # raw country-year panel
  
  # ---- Apply minimum observation threshold (>=30) ----
  obs_count <- df %>%
    group_by(Country_ISO) %>%
    summarise(n_obs = sum(!is.na(yield_hg_per_ha)), .groups = "drop")   # valid observation count per country
  
  eligible_countries <- obs_count %>%
    filter(n_obs >= 30) %>%       # threshold: 30 observations
    pull(Country_ISO)
  
  cat("Eligible countries (>=30 obs):", length(eligible_countries), "\n")
  
  df_elig <- df %>% filter(Country_ISO %in% eligible_countries)   # keep only eligible countries
  
  # ---- Build climate fingerprint (one row per country) ----
  fingerprint <- df_elig %>%
    group_by(Country_ISO) %>%
    summarise(
      mean_TMX = mean(TMX_ann, na.rm = TRUE),         # mean max temperature
      sd_TMX   = sd(TMX_ann,   na.rm = TRUE),         # temperature variability
      mean_PRE = mean(PRE_ann, na.rm = TRUE),         # mean precipitation
      sd_PRE   = sd(PRE_ann,   na.rm = TRUE),         # precipitation variability
      mean_GDP = mean(GDP_per_Capita, na.rm = TRUE),  # mean GDP per capita
      .groups = "drop"
    ) %>%
    filter(complete.cases(.))   # drop countries with any missing fingerprint value
  
  cat("Countries with a fingerprint:", nrow(fingerprint), "\n")
  
  # ---- K-means: pick 5 target countries (closest country to each cluster centroid) ----
  fp_scaled <- scale(fingerprint[, c("mean_TMX","sd_TMX","mean_PRE","sd_PRE","mean_GDP")])  # standardize (units differ)
  km <- kmeans(fp_scaled, centers = 5, nstart = 25)   # 5 climate clusters, best of 25 random starts
  
  target_countries <- character(5)
  for (k in 1:5) {
    idx_in_cluster <- which(km$cluster == k)                       # row indices of countries in this cluster
    centroid <- km$centers[k, ]                                    # cluster centroid
    dists <- apply(fp_scaled[idx_in_cluster, , drop = FALSE], 1,
                   function(row) sqrt(sum((row - centroid)^2)))    # Euclidean distance to centroid
    closest <- idx_in_cluster[which.min(dists)]                    # country closest to the centroid
    target_countries[k] <- fingerprint$Country_ISO[closest]
  }
  
  cat("Selected 5 target countries:", paste(target_countries, collapse = ", "), "\n")
  
  # ---- Fixed source pool S (N=20) - stratified random sample from non-target countries ----
  pool_candidates_fp <- fingerprint %>% filter(!Country_ISO %in% target_countries)
  pool_clusters <- km$cluster[match(pool_candidates_fp$Country_ISO, fingerprint$Country_ISO)]
  
  pool_countries <- character(0)
  n_per_cluster <- round(20 * table(pool_clusters) / length(pool_clusters))   # proportional allocation per cluster
  
  for (k in unique(pool_clusters)) {
    cluster_pool <- pool_candidates_fp$Country_ISO[pool_clusters == k]
    n_take <- min(n_per_cluster[as.character(k)], length(cluster_pool))
    pool_countries <- c(pool_countries, sample(cluster_pool, n_take))   # reproducible thanks to seed=42
  }
  
  # fix rounding errors so the pool is exactly 20 countries
  if (length(pool_countries) > 20) {
    pool_countries <- sample(pool_countries, 20)
  } else if (length(pool_countries) < 20) {
    remaining <- setdiff(pool_candidates_fp$Country_ISO, pool_countries)
    extra <- sample(remaining, 20 - length(pool_countries))
    pool_countries <- c(pool_countries, extra)
  }
  
  cat("Fixed source pool (N=20):", paste(pool_countries, collapse = ", "), "\n")
  
  # ---- Candidate source countries: everyone outside pool + target ----
  candidate_countries <- fingerprint$Country_ISO[
    !fingerprint$Country_ISO %in% c(target_countries, pool_countries)
  ]
  
  cat("Number of candidate source countries:", length(candidate_countries), "\n")
  
  # ---- Build small summary tables for this crop (to be combined across crops later) ----
  selection_tbl <- bind_rows(
    data.frame(crop = crop_name, country = target_countries,    role = "target"),
    data.frame(crop = crop_name, country = pool_countries,      role = "pool"),
    data.frame(crop = crop_name, country = candidate_countries, role = "candidate")
  )
  
  fingerprint_tbl <- fingerprint %>% mutate(crop = crop_name, .before = 1)   # add crop column for stacking
  
  list(selection = selection_tbl, fingerprint = fingerprint_tbl)
}

# ---- Process all crops ----
results_by_crop <- lapply(crops, process_crop)
names(results_by_crop) <- crops
results_by_crop <- results_by_crop[!sapply(results_by_crop, is.null)]   # drop crops whose file was missing

cat("\nCrops processed:", length(results_by_crop), "/", length(crops), "\n")

# ---- Combine results across crops into two flat tables ----
selection_all   <- bind_rows(lapply(results_by_crop, `[[`, "selection"))
fingerprint_all <- bind_rows(lapply(results_by_crop, `[[`, "fingerprint"))

# ---- Save everything as a single Excel workbook (no RDS) ----
# Step 2 will re-read the raw panelv7_<crop>.xlsx files itself and just
