library(readxl)    # read xlsx input
library(openxlsx)  # write xlsx output
library(dplyr)      # data manipulation
library(xgboost)    # nonlinear classifier (single-feature, for consistency with steps 5/7)

set.seed(42)

# ---- 0. Folder paths (same convention as steps 1-9) ----
data_dir <- "C:/Users/Alper.Tosun/Desktop/cru130"
proj_dir <- file.path(data_dir, "negatif_transfer")

# ---- 1. Load step-9 output ----
step9_path <- file.path(proj_dir, "negstep9_output.xlsx")
