# ==============================================================================
# STEP 1 -- CRU + CROPGRIDS -> monthly panel (panelv1)
#
# Loop order: COUNTRY on the outside, CROP on the inside.
#
# Climate data (CRU) does not depend on crop -- a country's temperature and
# precipitation series is the same regardless of which crop is being
# weighted. Only the AREA WEIGHT raster (CROPGRIDS) depends on crop. The
# previous crop-outer loop order re-cropped and re-masked the full 768-layer
# CRU stack once per crop per country (8x redundant work for the same
# country). Looping country-outer instead means each country's CRU stack is
# cropped and masked ONCE, then reused for all 8 crops -- only the cheap
# CROPGRIDS resample step is repeated per crop.
#
# For each country:
#   1. Clip to GADM boundary, crop+mask the CRU stack ONCE
#   2. For each crop: resample that crop's CROPGRIDS weight raster,
#      compute the weighted mean of each CRU variable across the country
#   3. Append the resulting row to that crop's panel
# After all countries: write each crop's panel to panelv1_<crop>.xlsx
# ==============================================================================

# -- CROPGRIDS file/variable helpers --------------------------------------------
# VERIFY the file naming pattern and the harvested-area variable name against
# the actual downloaded CROPGRIDS files -- adjust cropgrids_file() and the
# candidate variable names in load_cropgrids_harvarea() if they don't match.

cropgrids_file <- function(cropgrids_key) {
  # Official naming for the downloaded version: CROPGRIDSv1.08_[CROP].nc
  primary <- file.path(cropgrids_dir, paste0("CROPGRIDSv1.08_", cropgrids_key, ".nc"))
  if (file.exists(primary)) return(primary)
  
  # Fallback: scan the directory for any CROPGRIDS file matching this crop
  # name, in case a different dataset version (e.g. v1.08) was downloaded
  candidates <- list.files(
    cropgrids_dir,
    pattern = paste0("^CROPGRIDSv.*_", cropgrids_key, "\\.nc$"),
    full.names = TRUE, ignore.case = TRUE)
  if (length(candidates) >= 1) return(candidates[1])
  
  primary   # return the expected path anyway so the [!] message is informative
}

# Loads the harvested-area layer from a CROPGRIDS NetCDF file. CROPGRIDS
# NetCDFs typically contain multiple variables (e.g. harvested area,
# irrigated/rainfed splits); this picks the harvested-area one by name
# matching, and reports the variables actually found if none match so the
# candidate list can be corrected.
#
# CRITICAL: CROPGRIDS encodes non-harvested-area pixels with NEGATIVE
# sentinel codes -- -1 = "not assessed", -2 = "ocean/water" -- rather than
# NA. Left as literal negative numbers, these act as negative weights in
# every downstream weighted-average calculation, which can silently flip
# the sign or blow up the scale of TMX_ann/PRE_ann for any country whose
# boundary includes such pixels (coastal countries especially). They are
# converted to NA here, once, so nothing downstream ever sees them.
load_cropgrids_harvarea <- function(nc_path) {
  candidates <- c("harvarea", "harvested_area", "harv_area", "area",
                  "cropland_area", "hectares")
  sds <- tryCatch(terra::sds(nc_path), error = function(e) NULL)
  r <- if (is.null(sds)) {
    tryCatch(terra::rast(nc_path), error = function(e) NULL)
  } else {
    var_names <- names(sds)
    match_idx  <- which(tolower(var_names) %in% candidates)
    if (length(match_idx) == 0) {
      cat("  [WARNING] No harvested-area variable match in", basename(nc_path),
          "-- available variables:", paste(var_names, collapse = ", "), "\n")
      match_idx <- 1   # fallback: first variable, flagged above for manual check
    }
    sds[[match_idx[1]]]
  }
  if (!is.null(r)) r[r < 0] <- NA   # strip -1 "not assessed" / -2 "ocean" flags
  r
}

# -- Load CRU files once (shared across all countries and all crops) -----------
cat("[*] Loading CRU files (shared across all crops)...\n")
cru_list <- list()
for (v in names(cru_var_info)) {
  nc_path <- file.path(climate_dir, cru_var_info[[v]]$nc)
  if (!file.exists(nc_path)) { cat("  [!] Missing:", nc_path, "\n"); next }
  cru_list[[v]] <- terra::rast(nc_path)
  cat("  [OK]", v, "-", terra::nlyr(cru_list[[v]]), "layers\n")
}

# -- Load each crop's CROPGRIDS harvested-area raster once (shared across all countries) --
cat("\n[*] Loading CROPGRIDS harvested-area rasters (one per crop)...\n")
cropgrids_rast <- list()
for (crop_name in names(crop_config)) {
  cg_file <- cropgrids_file(crop_config[[crop_name]]$cropgrids)
  if (!file.exists(cg_file)) {
    cat("  [!] Missing CROPGRIDS file for", crop_name, ":", cg_file, "\n"); next
  }
  cropgrids_rast[[crop_name]] <- load_cropgrids_harvarea(cg_file)
  cat("  [OK]", crop_name, "-", basename(cg_file), "\n")
}

missing_cg <- setdiff(names(crop_config), names(cropgrids_rast))
if (length(missing_cg) > 0)
  stop("CROPGRIDS files missing for: ", paste(missing_cg, collapse = ", "),
       " -- check cropgrids_dir and file naming before continuing")

# -- Main country-outer loop -----------------------------------------------------
cat("\n", strrep("#", 60), "\nSTEP 1: PROCESSING", length(country_list),
    "COUNTRIES x 8 CROPS\n", strrep("#", 60), "\n\n")

panel_list <- setNames(vector("list", length(crop_config)), names(crop_config))
for (crop_name in names(crop_config)) panel_list[[crop_name]] <- list()

for (iso in country_list) {
  cat("\n>>", iso)
  t0 <- Sys.time()
  
  # Load GADM country boundary (use cached .rds if available)
  gadm_cache <- file.path(base_dir, "gadm",
                          paste0("gadm_41_", iso, "_0_pk.rds"))
  if (file.exists(gadm_cache)) {
    boundary <- readRDS(gadm_cache)
    cat(" [cache]")
  } else {
    boundary <- tryCatch(
      geodata::gadm(country = iso, level = 0, path = base_dir),
      error = function(e) { cat(" [GADM error]"); NULL })
  }
  if (is.null(boundary)) next
  
  # Crop + mask the full CRU stack ONCE for this country -- reused by all 8 crops
  cru_country <- list()
  for (v in names(cru_list)) {
    cru_country[[v]] <- terra::mask(
      terra::crop(cru_list[[v]], terra::ext(boundary)), boundary)
  }
  
  # For each crop: resample that crop's CROPGRIDS weight and compute the
  # weighted mean of each CRU variable using the already-cropped CRU stack
  for (crop_name in names(crop_config)) {
    cg_global <- cropgrids_rast[[crop_name]]
    cg_crop   <- terra::crop(cg_global, terra::ext(boundary))
    
    country_tbl <- data.frame(Country_ISO = iso,
                              Yil = year_month_df$Yil, Ay = year_month_df$Ay)
    
    ref_r    <- cru_country[[1]][[1]]
    cg_res   <- terra::resample(cg_crop, ref_r, method = "sum")
    cg_m     <- terra::mask(cg_res, boundary)
    w_base   <- as.vector(terra::values(cg_m))
    has_area <- !is.na(sum(w_base, na.rm = TRUE)) &&
      sum(w_base, na.rm = TRUE) > 0
    
    for (v in names(cru_country)) {
      v_mat <- terra::values(cru_country[[v]])   # matrix: pixels x 768 months
      
      if (has_area) {
        # Re-resample CROPGRIDS weight to this variable's resolution
        cg_res2 <- terra::resample(cg_crop, cru_country[[v]][[1]], method = "sum")
        w  <- as.vector(terra::values(terra::mask(cg_res2, boundary)))
        ws <- sum(w, na.rm = TRUE)
        monthly <- if (!is.na(ws) && ws > 0)
          colSums(v_mat * w, na.rm = TRUE) / ws   # weighted mean
        else
          colMeans(v_mat, na.rm = TRUE)            # fallback: simple mean
      } else {
        monthly <- colMeans(v_mat, na.rm = TRUE)
      }
      
      if (cru_var_info[[v]]$scale) monthly <- check_scale(monthly, v)
      country_tbl[[toupper(v)]] <- monthly
    }
    
    panel_list[[crop_name]][[iso]] <- country_tbl
  }
  
  cat("  [", round(difftime(Sys.time(), t0, units = "secs"), 1), "s]")
}

# -- Combine and save each crop's panel ------------------------------------------
for (crop_name in names(crop_config)) {
  cfg <- crop_config[[crop_name]]
  panel_final <- do.call(rbind, panel_list[[crop_name]])
  panel_final <- panel_final[order(panel_final$Country_ISO,
                                   panel_final$Yil, panel_final$Ay), ]
  rownames(panel_final) <- NULL
  
  cat("\n[OK]", crop_name, "- Rows:", nrow(panel_final),
      "| Cols:", ncol(panel_final), "\n")
  
  output_path <- file.path(base_dir, paste0(cfg$p1, ".xlsx"))
  writexl::write_xlsx(panel_final, output_path)
  cat("[SAVED]", output_path, "\n")
}
