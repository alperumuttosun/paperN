}

# ---- Permutation test (STRATIFIED BY CROP - corrected version) ----
# The naive version of this test (shuffling labels across ALL rows, ignoring
# crop membership) is WRONG: it treats 2400+ rows as independent replicates,
# when the real number of independent units is only 8 (the crops). That
# inflates significance almost automatically for any large pooled sample.
#
# The corrected version shuffles labels ONLY WITHIN each crop's own test
# block, preserving each crop's true negative-transfer rate (its "base
# rate") and the crop grouping structure, while destroying any row-level
# correspondence between a candidate's predicted score and its true label
# within that crop. This tests: "beyond just knowing which crop a pair
# belongs to, does the model's score for a SPECIFIC pair carry real
# information?" - which is the question we actually care about.
permutation_test <- function(oof_pred, y_all, crop_vec, n_perm = 500) {
  observed <- auroc(oof_pred, y_all)
  perm_stats <- numeric(n_perm)
  for (p in 1:n_perm) {
    y_perm <- y_all
    for (c in unique(crop_vec)) {
      idx <- which(crop_vec == c)
      y_perm[idx] <- sample(y_all[idx])   # shuffle labels ONLY inside this crop's block
    }
    perm_stats[p] <- auroc(oof_pred, y_perm)
  }
  p_value <- mean(abs(perm_stats - 0.5) >= abs(observed - 0.5))   # two-sided
  list(observed = observed, p_value = p_value, perm_mean = mean(perm_stats), perm_sd = sd(perm_stats))
}

# ---- Run everything ----
res_lasso <- run_loco("NT_lasso")
res_xgb   <- run_loco("NT_xgb")

perm_lasso <- permutation_test(res_lasso$oof_pred, res_lasso$y_all, feat_full$crop)
perm_xgb   <- permutation_test(res_xgb$oof_pred,   res_xgb$y_all,   feat_full$crop)

summary_tbl <- bind_rows(
  data.frame(nt_column = "NT_lasso", observed_auroc = perm_lasso$observed,
             permutation_p_value = perm_lasso$p_value,
             null_mean = perm_lasso$perm_mean, null_sd = perm_lasso$perm_sd),
  data.frame(nt_column = "NT_xgb", observed_auroc = perm_xgb$observed,
             permutation_p_value = perm_xgb$p_value,
             null_mean = perm_xgb$perm_mean, null_sd = perm_xgb$perm_sd)
)

cat("\n--- Permutation test summary ---\n")
print(summary_tbl)

per_crop_all <- bind_rows(res_lasso$per_crop, res_xgb$per_crop)

# ---- Save everything as Excel (no RDS) ----
out_path <- file.path(proj_dir, "negstep7_output.xlsx")

wb <- createWorkbook()
addWorksheet(wb, "permutation_summary")   # observed AUROC vs. null distribution, p-value
addWorksheet(wb, "loco_per_crop_oracle")  # per-crop LOCO AUROC/PR-AUC with the oracle feature set
addWorksheet(wb, "oracle_feature_table")  # the oracle feature matrix used

writeData(wb, "permutation_summary", summary_tbl)
writeData(wb, "loco_per_crop_oracle", per_crop_all)
writeData(wb, "oracle_feature_table", feat_full)

saveWorkbook(wb, out_path, overwrite = TRUE)

cat("\nStep 7 complete. Output saved to:\n", out_path, "\n")




















