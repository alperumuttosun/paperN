# ---- Function: Mahalanobis distance between two countries' fingerprints ----
mahalanobis_dist <- function(fp_mat, cov_inv, country_a, country_b) {
  diff_vec <- fp_mat[country_a, ] - fp_mat[country_b, ]
  sqrt(as.numeric(t(diff_vec) %*% cov_inv %*% diff_vec))
}

# ---- Process one crop: compute D_pool for every (target, candidate) pair ----
process_crop_step3 <- function(crop_name) {
  
  cat("\n----", toupper(crop_name), "----\n")
  
  sel_crop <- selection %>% filter(crop == crop_name)
  target_countries <- sel_crop$country[sel_crop$role == "target"]
  pool_countries   <- sel_crop$country[sel_crop$role == "pool"]
  
  fp_crop <- fingerprint %>% filter(crop == crop_name)
  fp_mat  <- as.matrix(fp_crop[, c("mean_TMX","sd_TMX","mean_PRE","sd_PRE","mean_GDP")])
  rownames(fp_mat) <- fp_crop$Country_ISO
  cov_inv <- solve(cov(fp_mat))   # same inverse covariance used in step 2, for consistency
  
  pairwise_crop <- pairwise %>% filter(crop == crop_name)   # NT values already computed in step 2
  
  out <- list()
  
  for (t in target_countries) {
    
    # average distance from the fixed pool S to this target (does not depend on the candidate)
    dist_S_to_t <- sapply(pool_countries, function(p) mahalanobis_dist(fp_mat, cov_inv, p, t))
    avg_dist_S  <- mean(dist_S_to_t)
    
    rows_t <- pairwise_crop %>% filter(target == t)
    
    for (i in seq_len(nrow(rows_t))) {
      s <- rows_t$candidate[i]
      
      # average distance from S union {s} to target = weighted average of the pool's distances and s's own distance
      dist_s_to_t <- mahalanobis_dist(fp_mat, cov_inv, s, t)
      avg_dist_Ss <- (sum(dist_S_to_t) + dist_s_to_t) / (length(pool_countries) + 1)
      
      D_pool <- avg_dist_Ss - avg_dist_S   # positive = adding s moves the pool further from target on average
      
      out[[length(out) + 1]] <- data.frame(
        crop      = crop_name,
        target    = t,
        candidate = s,
        D_pool    = D_pool
      )
    }
  }
  
  bind_rows(out)
}

# ---- Run step 3 for every crop ----
dpool_all <- bind_rows(lapply(crops_available, process_crop_step3))

# ---- Join D_pool back onto the step-2 results (which already has D_mahalanobis, NT_lasso, NT_xgb) ----
combined <- pairwise %>%
