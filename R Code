# negatifstep4.R
# Negative Transfer pilot - Step 4: can a NONLINEAR model,
# using distance-based and fingerprint-difference features,
# predict I(NT<0) better than the plain rank correlations
# from steps 2-3?
# Evaluated with 5-fold cross-validated AUROC and PR-AUC.
# =========================================================

library(readxl)    # read xlsx input
library(openxlsx)  # write xlsx output
library(dplyr)      # data manipulation
library(xgboost)    # nonlinear classifier

set.seed(42)

# ---- 0. Folder paths (same convention as steps 1-3) ----
data_dir <- "C:/Users/Alper.Tosun/Desktop/cru130"
proj_dir <- file.path(data_dir, "negatif_transfer")

# ---- 1. Load step-1 and step-3 output ----
# step3's "pairwise_with_Dpool" sheet already has crop, target, candidate,
# D_mahalanobis, D_pool, NT_lasso, NT_xgb - everything we need except the
# raw fingerprint components, which we pull from step 1 to build extra features.
step1_path <- file.path(proj_dir, "negstep1_output.xlsx")
step3_path <- file.path(proj_dir, "negstep3_output.xlsx")

fingerprint <- read_excel(step1_path, sheet = "fingerprint")             # crop, country, climate/GDP fingerprint
combined    <- read_excel(step3_path, sheet = "pairwise_with_Dpool")     # crop, target, candidate, D, D_pool, NT_lasso, NT_xgb

cat("Total pairs loaded:", nrow(combined), "\n")

# ---- 2. Build extra features: raw fingerprint differences (candidate - target) ----
fp_target <- fingerprint %>%
  rename_with(~ paste0("t_", .), c(mean_TMX, sd_TMX, mean_PRE, sd_PRE, mean_GDP)) %>%
  rename(target = Country_ISO)

fp_candidate <- fingerprint %>%
  rename_with(~ paste0("s_", .), c(mean_TMX, sd_TMX, mean_PRE, sd_PRE, mean_GDP)) %>%
  rename(candidate = Country_ISO)

feat <- combined %>%
  left_join(fp_target,    by = c("crop", "target")) %>%
  left_join(fp_candidate, by = c("crop", "candidate")) %>%
  mutate(
    diff_TMX = s_mean_TMX - t_mean_TMX,   # raw temperature gap (not just its magnitude, like D does)
    diff_PRE = s_mean_PRE - t_mean_PRE,   # raw precipitation gap
    diff_GDP = s_mean_GDP - t_mean_GDP    # raw GDP gap
  )

feature_cols <- c("D_mahalanobis", "D_pool", "diff_TMX", "diff_PRE", "diff_GDP")

# one-hot encode crop so the pooled model can learn crop-specific baselines
crop_dummies <- model.matrix(~ crop - 1, data = feat)

# ---- Function: 5-fold CV AUROC (rank-based, no extra package needed) ----
auroc <- function(scores, labels) {
  n1 <- sum(labels == 1); n0 <- sum(labels == 0)
  if (n1 == 0 || n0 == 0) return(NA)
  r <- rank(scores)
  (sum(r[labels == 1]) - n1 * (n1 + 1) / 2) / (n1 * n0)
}

# ---- Function: 5-fold CV PR-AUC (trapezoidal integration over precision-recall points) ----
pr_auc <- function(scores, labels) {
  ord <- order(-scores)
  lab <- labels[ord]
  tp <- cumsum(lab)
  fp <- cumsum(1 - lab)
  precision <- tp / (tp + fp)
  recall    <- tp / sum(lab)
  auc <- 0; prev_r <- 0; prev_p <- 1
  for (i in seq_along(recall)) {
    auc <- auc + (recall[i] - prev_r) * (precision[i] + prev_p) / 2   # trapezoid area under this segment
    prev_r <- recall[i]; prev_p <- precision[i]
  }
  auc
}

# ---- Function: run 5-fold CV for one NT column, return out-of-fold AUROC and PR-AUC ----
# for both the nonlinear (XGBoost) model and a simple linear (logistic) baseline
run_cv <- function(nt_col) {
  
  y <- as.integer(feat[[nt_col]] < 0)     # 1 = negative transfer, 0 = not
  x_dist <- as.matrix(feat[, feature_cols])
  x_full <- cbind(x_dist, crop_dummies)   # distance features + crop dummies
  
  n <- nrow(feat)
  folds <- sample(rep(1:5, length.out = n))   # random 5-fold split
  
  oof_xgb    <- numeric(n)   # out-of-fold predicted probability, XGBoost
  oof_linear <- numeric(n)   # out-of-fold predicted probability, logistic regression baseline
  
  for (k in 1:5) {
    train_idx <- which(folds != k)
    test_idx  <- which(folds == k)
    
    # nonlinear model
    model_xgb <- xgboost(x = x_full[train_idx, ], y = factor(y[train_idx]),
                         nrounds = 100, max_depth = 3, learning_rate = 0.1,
                         objective = "binary:logistic")
    oof_xgb[test_idx] <- predict(model_xgb, x_full[test_idx, ])
    
    # simple linear baseline for comparison (does nonlinearity actually help?)
    train_df <- data.frame(y = y[train_idx], x_dist[train_idx, ])
    test_df  <- data.frame(x_dist[test_idx, ])
    model_lin <- glm(y ~ ., data = train_df, family = binomial())
    oof_linear[test_idx] <- predict(model_lin, newdata = test_df, type = "response")
  }
  
  data.frame(
    nt_column        = nt_col,
    auroc_xgb        = auroc(oof_xgb, y),
    pr_auc_xgb       = pr_auc(oof_xgb, y),
    auroc_linear     = auroc(oof_linear, y),
    pr_auc_linear    = pr_auc(oof_linear, y),
    pct_negative     = mean(y) * 100
  )
}

