# negatifstep2.R
# Negative Transfer pilot - Step 2: train models, compute
# NT(s|S,t) for every (target, candidate) pair, and test
# whether distance-based predictors track NT.
# Runs for every crop found in negstep1_output.xlsx
# =========================================================

library(readxl)    # read xlsx input
library(openxlsx)  # write xlsx output
library(dplyr)      # data manipulation
library(glmnet)     # LASSO
library(xgboost)    # XGBoost

set.seed(42)   # reproducibility

# ---- 0. Folder paths (same convention as step 1) ----
data_dir <- "C:/Users/Alper.Tosun/Desktop/cru130"
proj_dir <- file.path(data_dir, "negatif_transfer")

# ---- 1. Load step-1 output ----
step1_path <- file.path(proj_dir, "negstep1_output.xlsx")
selection   <- read_excel(step1_path, sheet = "selection")     # crop, country, role
fingerprint <- read_excel(step1_path, sheet = "fingerprint")   # crop, country, climate/GDP fingerprint

crops_available <- unique(selection$crop)   # crops that step 1 actually produced
cat("Crops found in step-1 output:", paste(crops_available, collapse = ", "), "\n")

# features used to predict yield
# FINAL, SIMPLIFIED SPECIFICATION (after review):
#  - CO2_ppm removed entirely: it is a purely global/time-level variable
#    (identical across all countries within a given year), so it carries
#    zero cross-country information and effectively behaves as a calendar-
#    time proxy in a design meant to capture country-to-country transfer.
#  - TMN_ann and DTR_ann removed: DTR = TMX - TMN by construction, so
#    keeping TMX, TMN and DTR together creates an exact linear dependence.
#  - PET_ann dropped to keep the design simple, per a deliberate decision
#    to keep the feature set small.
# Final set: two core climate variables (TMX, PRE) plus GDP per capita as
# a robustness/control variable - three predictors total, consistent with
# the fingerprint already used for country selection and distance (step 1).
feature_cols <- c("TMX_ann", "PRE_ann", "GDP_per_Capita")

# ---- Function: fit LASSO on train_df, return RMSE on test_df ----
fit_lasso_rmse <- function(train_df, test_df) {
  x_train <- as.matrix(train_df[, feature_cols])         # predictor matrix
  y_train <- log(train_df$yield_hg_per_ha)                # log-yield as response (stabilizes variance)
  x_test  <- as.matrix(test_df[, feature_cols])
  y_test  <- log(test_df$yield_hg_per_ha)

  cvfit <- cv.glmnet(x_train, y_train, alpha = 1, nfolds = 5)   # alpha=1 -> LASSO, pick lambda by 5-fold CV
  pred  <- predict(cvfit, newx = x_test, s = "lambda.min")       # predict at the best lambda

  sqrt(mean((exp(pred) - exp(y_test))^2))   # RMSE back on the original yield scale
}

# ---- Function: fit XGBoost on train_df, return RMSE on test_df ----
fit_xgb_rmse <- function(train_df, test_df) {
  x_train <- as.matrix(train_df[, feature_cols])
  y_train <- log(train_df$yield_hg_per_ha)
  x_test  <- as.matrix(test_df[, feature_cols])
  y_test  <- log(test_df$yield_hg_per_ha)

  model <- xgboost(x = x_train, y = y_train, nrounds = 100, max_depth = 4,
                   learning_rate = 0.1, objective = "reg:squarederror")   # xgboost R API (>=2.0): x/y instead of DMatrix
  pred <- predict(model, x_test)

  sqrt(mean((exp(pred) - exp(y_test))^2))
}

# ---- Function: Mahalanobis distance between two countries' fingerprints ----
mahalanobis_dist <- function(fp_mat, cov_inv, country_a, country_b) {
  diff_vec <- fp_mat[country_a, ] - fp_mat[country_b, ]
  sqrt(as.numeric(t(diff_vec) %*% cov_inv %*% diff_vec))
}

# ---- Process a single crop: compute NT for every (target, candidate) pair ----
process_crop_step2 <- function(crop_name) {

  cat("\n----", toupper(crop_name), "----\n")

  file_path <- file.path(data_dir, paste0("panelv7_", crop_name, ".xlsx"))
  df <- read_excel(file_path) %>%
    filter(complete.cases(select(., all_of(c("yield_hg_per_ha", feature_cols)))))   # drop rows with missing features

  sel_crop <- selection %>% filter(crop == crop_name)
  target_countries    <- sel_crop$country[sel_crop$role == "target"]
  pool_countries      <- sel_crop$country[sel_crop$role == "pool"]
  candidate_countries <- sel_crop$country[sel_crop$role == "candidate"]

  # fingerprint matrix for Mahalanobis distance (one row per country)
  fp_crop <- fingerprint %>% filter(crop == crop_name)
  fp_mat  <- as.matrix(fp_crop[, c("mean_TMX","sd_TMX","mean_PRE","sd_PRE","mean_GDP")])
  rownames(fp_mat) <- fp_crop$Country_ISO
  cov_inv <- solve(cov(fp_mat))   # inverse covariance, shared across all distance calculations for this crop

  pool_data <- df %>% filter(Country_ISO %in% pool_countries)   # fixed pool S training data (reused for every target)

  results <- list()   # collect one row per (target, candidate, model)

  for (t in target_countries) {

    test_data <- df %>% filter(Country_ISO == t)
    if (nrow(test_data) < 5) next   # too few rows to evaluate reliably, skip this target
    n_obs_target <- nrow(test_data)   # target's own observation count (for later sample-size robustness checks)

    # ---- baseline: train on S only ----
    rmse_base_lasso <- fit_lasso_rmse(pool_data, test_data)
    rmse_base_xgb   <- fit_xgb_rmse(pool_data, test_data)

    for (s in candidate_countries) {

      cand_data <- df %>% filter(Country_ISO == s)
      if (nrow(cand_data) < 5) next   # skip candidates with too little data
      n_obs_candidate <- nrow(cand_data)   # candidate's observation count - how many rows it adds to the pool

      train_plus_s <- bind_rows(pool_data, cand_data)   # S union {s}

      rmse_add_lasso <- fit_lasso_rmse(train_plus_s, test_data)
      rmse_add_xgb   <- fit_xgb_rmse(train_plus_s, test_data)

      d_st <- mahalanobis_dist(fp_mat, cov_inv, s, t)   # simple pairwise distance predictor

      results[[length(results) + 1]] <- data.frame(
        crop      = crop_name,
        target    = t,
        candidate = s,
        D_mahalanobis = d_st,
        NT_lasso  = rmse_base_lasso - rmse_add_lasso,   # positive = candidate helped, negative = negative transfer
        NT_xgb    = rmse_base_xgb   - rmse_add_xgb,
        n_obs_candidate = n_obs_candidate,   # NEW: candidate's row count - lets us check whether NT is confounded with sample-size imbalance
        n_obs_target    = n_obs_target       # NEW: target's own row count
      )
    }
    cat("  target", t, "done (", length(candidate_countries), "candidates )\n")
  }

  bind_rows(results)
}

# ---- Run step 2 for every crop ----
all_results <- bind_rows(lapply(crops_available, process_crop_step2))

cat("\nTotal (target, candidate) pairs evaluated:", nrow(all_results), "\n")

# ---- Summary: does distance predict NT? (Spearman correlation, per crop and model) ----
summary_tbl <- all_results %>%
  group_by(crop) %>%
  summarise(
    n_pairs                 = n(),
    pct_negative_NT_lasso    = mean(NT_lasso < 0) * 100,          # share of pairs that are negative transfer (LASSO)
    pct_negative_NT_xgb      = mean(NT_xgb   < 0) * 100,          # same, for XGBoost
    spearman_D_vs_NT_lasso   = cor(D_mahalanobis, NT_lasso, method = "spearman"),
    spearman_D_vs_NT_xgb     = cor(D_mahalanobis, NT_xgb,   method = "spearman"),
    .groups = "drop"
  )

print(summary_tbl)

# ---- Save everything as Excel (no RDS) ----
out_path <- file.path(proj_dir, "negstep2_output.xlsx")

wb <- createWorkbook()
addWorksheet(wb, "pairwise_results")   # every (target, candidate) row with NT and distance
addWorksheet(wb, "summary_by_crop")    # per-crop Spearman correlation + % negative transfer

writeData(wb, "pairwise_results", all_results)
writeData(wb, "summary_by_crop", summary_tbl)

saveWorkbook(wb, out_path, overwrite = TRUE)

cat("\nStep 2 complete. Output saved to:\n", out_path, "\n")


