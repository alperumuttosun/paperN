      auroc         = auroc(pred, y_all[test_idx]),
      pr_auc        = pr_auc(pred, y_all[test_idx])
    )
  }
  
  per_crop_tbl <- bind_rows(per_crop)
  
  overall_row <- data.frame(
    nt_column     = nt_col,
