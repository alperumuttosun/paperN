# ---- Function: AUROC (rank-based) ----
auroc <- function(scores, labels) {
  n1 <- sum(labels == 1); n0 <- sum(labels == 0)
  if (n1 == 0 || n0 == 0) return(NA)
  r <- rank(scores)
  (sum(r[labels == 1]) - n1 * (n1 + 1) / 2) / (n1 * n0)
}

# ---- Function: PR-AUC (trapezoidal integration) ----
pr_auc <- function(scores, labels) {
  ord <- order(-scores)
  lab <- labels[ord]
  tp <- cumsum(lab)
  fp <- cumsum(1 - lab)
  precision <- tp / (tp + fp)
  recall    <- tp / sum(lab)
  auc <- 0; prev_r <- 0; prev_p <- 1
  for (i in seq_along(recall)) {
    auc <- auc + (recall[i] - prev_r) * (precision[i] + prev_p) / 2
    prev_r <- recall[i]; prev_p <- precision[i]
  }
  auc
}

# ---- Function: run leave-one-crop-out for one NT definition ----
run_loco <- function(nt_col) {
  
  y_all <- as.integer(feat[[nt_col]] < 0)
  x_all <- as.matrix(feat[, feature_cols])
  
  oof_pred <- numeric(nrow(feat))   # holds each row's prediction from when ITS crop was held out
  per_crop <- list()
  
  for (held_out in crops_available) {
    
    train_idx <- which(feat$crop != held_out)
    test_idx  <- which(feat$crop == held_out)
    
    model <- xgboost(x = x_all[train_idx, ], y = factor(y_all[train_idx]),
                     nrounds = 100, max_depth = 3, learning_rate = 0.1,
                     objective = "binary:logistic")
    
    pred <- predict(model, x_all[test_idx, ])
    oof_pred[test_idx] <- pred
    
    per_crop[[held_out]] <- data.frame(
      nt_column     = nt_col,
      held_out_crop = held_out,
      n_test        = length(test_idx),
      pct_negative  = mean(y_all[test_idx]) * 100,
      auroc         = auroc(pred, y_all[test_idx]),
      pr_auc        = pr_auc(pred, y_all[test_idx])
    )
  }
  
  per_crop_tbl <- bind_rows(per_crop)
  
  overall_row <- data.frame(
    nt_column     = nt_col,
    held_out_crop = "ALL_CROPS_POOLED",
    n_test        = length(oof_pred),
    pct_negative  = mean(y_all) * 100,
    auroc         = auroc(oof_pred, y_all),
    pr_auc        = pr_auc(oof_pred, y_all)
  )
  
  bind_rows(per_crop_tbl, overall_row)
}

