  summarise(
    crop = "ALL_CROPS_POOLED",
    n_pairs = n(),
    spearman_D_vs_NT_lasso     = cor(D_mahalanobis, NT_lasso, method = "spearman"),
    spearman_Dpool_vs_NT_lasso = cor(D_pool,         NT_lasso, method = "spearman"),
    spearman_D_vs_NT_xgb       = cor(D_mahalanobis, NT_xgb,   method = "spearman"),
    spearman_Dpool_vs_NT_xgb   = cor(D_pool,         NT_xgb,   method = "spearman")
  )

comparison_tbl <- bind_rows(comparison_tbl, overall_row)

print(comparison_tbl)

# ---- Save everything as Excel (no RDS) ----
out_path <- file.path(proj_dir, "negstep3_output.xlsx")

wb <- createWorkbook()
addWorksheet(wb, "pairwise_with_Dpool")   # every (target, candidate) row with both D and D_pool and NT
addWorksheet(wb, "D_vs_Dpool_comparison") # per-crop + overall Spearman comparison

writeData(wb, "pairwise_with_Dpool", combined)
writeData(wb, "D_vs_Dpool_comparison", comparison_tbl)

saveWorkbook(wb, out_path, overwrite = TRUE)

cat("\nStep 3 complete. Output saved to:\n", out_path, "\n")












