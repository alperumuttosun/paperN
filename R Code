# ---- LOCO with the oracle feature set ----
run_loco <- function(nt_col) {
  y_all <- as.integer(feat_full[[nt_col]] < 0)
  x_all <- as.matrix(feat_full[, feature_cols])
  crops_here <- unique(feat_full$crop)

  oof_pred <- numeric(nrow(feat_full))
