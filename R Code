# ---- 2. Build ORACLE features: pool composition, not just source-target distance ----
# For each crop we use its step-1 fingerprint (mean_TMX, sd_TMX, mean_PRE, sd_PRE,
# mean_GDP - the same fingerprint used throughout the pipeline) to compute:
#  - pool_heterogeneity:   average pairwise distance WITHIN the pool (is S diverse or redundant?)
#  - cand_to_poolcentroid: distance from the candidate to the pool's centroid (is it a pool outlier?)
#  - cand_redundancy:      candidate's minimum distance to any single pool member (redundancy proxy)
#  - extrapolation_flag:   1 if the candidate is more extreme than the whole pool on any
#                          fingerprint dimension (rough proxy for "outside the pool's support")

build_oracle_features <- function(crop_name) {

  cat("\n----", toupper(crop_name), "----\n")

  sel_crop <- selection %>% filter(crop == crop_name)
  pool_countries <- sel_crop$country[sel_crop$role == "pool"]

  fp_crop <- fingerprint %>% filter(crop == crop_name)
  fp_mat  <- as.matrix(fp_crop[, c("mean_TMX","sd_TMX","mean_PRE","sd_PRE","mean_GDP")])
  rownames(fp_mat) <- fp_crop$Country_ISO
  fp_scaled <- scale(fp_mat)                     # standardize before computing distances (units differ)
  rownames(fp_scaled) <- fp_crop$Country_ISO

  euc <- function(a, b) sqrt(sum((fp_scaled[a, ] - fp_scaled[b, ])^2))   # plain Euclidean, used for pool diversity

  pool_ok <- intersect(pool_countries, rownames(fp_scaled))

  # pool heterogeneity: mean pairwise Euclidean distance among pool members (one number per crop)
  pool_pairs <- combn(pool_ok, 2, simplify = FALSE)
  pool_heterogeneity <- mean(sapply(pool_pairs, function(p) euc(p[1], p[2])))

  pool_centroid <- colMeans(fp_scaled[pool_ok, , drop = FALSE])   # average fingerprint of the pool

  rows_crop <- feat %>% filter(crop == crop_name)

  out <- list()
  for (i in seq_len(nrow(rows_crop))) {
    s <- rows_crop$candidate[i]
    if (!(s %in% rownames(fp_scaled))) next

    dist_to_centroid <- sqrt(sum((fp_scaled[s, ] - pool_centroid)^2))       # candidate's distance to the pool's "center"
    min_dist_to_pool  <- min(sapply(pool_ok, function(p) euc(s, p)))         # candidate's distance to its nearest pool member

    # extrapolation flag: is the candidate more extreme than every pool member on at least one dimension?
    cand_vec   <- fp_scaled[s, ]
    pool_range <- apply(fp_scaled[pool_ok, , drop = FALSE], 2, range)
    outside <- any(cand_vec < pool_range[1, ] | cand_vec > pool_range[2, ])

    out[[length(out) + 1]] <- data.frame(
      crop = crop_name, target = rows_crop$target[i], candidate = s,
      pool_heterogeneity = pool_heterogeneity,
      cand_to_poolcentroid = dist_to_centroid,
      cand_redundancy = min_dist_to_pool,
      extrapolation_flag = as.integer(outside)
    )
  }

  bind_rows(out)
}

