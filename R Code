    year_col       <- grep("^year$|^yil$",  names(raw), value = TRUE)[1]
    val_col        <- grep("^value$",       names(raw), value = TRUE)[1]
    cropland_df    <- data.frame(
      Country_ISO          = raw[[iso_col]],
      Year                 = as.integer(raw[[year_col]]),
      cropland_area_1000ha = as.numeric(
        gsub(",", ".", as.character(raw[[val_col]]))))
    cropland_df <- cropland_df[
      !is.na(cropland_df$Country_ISO) &
        !is.na(cropland_df$Year) &
        cropland_df$Year >= 1961 &
        cropland_df$Year <= 2024, ]
    cat("[OK] Cropland:", nrow(cropland_df), "rows\n")
  }, error = function(e) {
    cat("[FALLBACK] FAOSTAT package failed:", conditionMessage(e), "\n")
  })
}

if (is.null(cropland_df) || nrow(cropland_df) == 0) {
  manual_paths <- c(
    file.path(base_dir, "cropland.csv"),
    file.path(base_dir, "cropland.xlsx"),
    file.path(base_dir, "FAOSTAT_cropland.csv"))
  found_path <- manual_paths[file.exists(manual_paths)]
  if (length(found_path) > 0) {
    file_to_use <- found_path[1]
    cat("[FALLBACK] Using:", basename(file_to_use), "\n")
    
    # Read raw file (CSV or XLSX)
    cropland_raw <- if (grepl("\\.csv$", file_to_use, ignore.case = TRUE))
      as.data.frame(data.table::fread(file_to_use, encoding = "UTF-8"))
    else
      as.data.frame(readxl::read_excel(file_to_use))
    names(cropland_raw) <- trimws(names(cropland_raw))
    
    # Expected shape: standard FAOSTAT bulk-download columns (Area, Year,
    # Value, and usually Item/Element/Unit) -- same shape as fao_csv and
    # irrigation_xl already used elsewhere in this script. If the actual
    # file uses different column names, adjust the checks below.
    required_cols <- c("Area", "Year", "Value")
    missing_cols  <- setdiff(required_cols, names(cropland_raw))
    if (length(missing_cols) > 0)
      stop("cropland file is missing expected column(s): ",
           paste(missing_cols, collapse = ", "),
           " -- actual columns are: ", paste(names(cropland_raw), collapse = ", "),
           " -- adjust the Step 5 fallback block to match")
    
    cropland_raw$Year  <- as.integer(gsub("'", "", as.character(cropland_raw$Year)))
    cropland_raw$Value <- as.numeric(gsub(",", ".", as.character(cropland_raw$Value)))
    
    # If an Element column is present, keep only the cropland-area element
    # (bulk FAOSTAT Land Use downloads may include multiple land-use series
    # in one file)
    if ("Element" %in% names(cropland_raw)) {
      keep_elements <- c("Area", "Cropland")
      cropland_raw  <- cropland_raw[cropland_raw$Element %in% keep_elements, ]
    }
    if ("Item" %in% names(cropland_raw)) {
      cropland_raw <- cropland_raw[grepl("Cropland", cropland_raw$Item,
                                         ignore.case = TRUE), ]
    }
    
    # Fix Turkey / Cote d'Ivoire naming, same convention as FAO production data
    cropland_raw$Area[grepl("rkiye|Turkey|TURKEY", cropland_raw$Area)] <-
      iso_map$fao_area[iso_map$Country_ISO == "TUR"][1]
    cropland_raw$Area[grepl("voire|Ivory", cropland_raw$Area, ignore.case = TRUE)] <-
      iso_map$fao_area[iso_map$Country_ISO == "CIV"][1]
    
    # Map country name -> ISO using the iso_map already built in Section 3
    # (same translation table used for fao_wide -- not a new/independent one)
    cropland_merged <- merge(cropland_raw, iso_map,
                             by.x = "Area", by.y = "fao_area", all.x = TRUE)
    
    unmatched_cropland <- sort(unique(
      cropland_merged$Area[is.na(cropland_merged$Country_ISO)]))
    if (length(unmatched_cropland) > 0) {
      cat("[WARNING] cropland file area names with no ISO match (dropped):\n")
      cat(" ", paste(unmatched_cropland, collapse = ", "), "\n")
    }
    
    cropland_df <- data.frame(
      Country_ISO          = cropland_merged$Country_ISO,
      Year                 = cropland_merged$Year,
      cropland_area_1000ha = cropland_merged$Value,
      stringsAsFactors = FALSE)
    cropland_df <- cropland_df[
      !is.na(cropland_df$Country_ISO) &
        !is.na(cropland_df$Year) &
        cropland_df$Year >= 1961 & cropland_df$Year <= 2024, ]
    
    cat("[OK] Cropland (manual file):", nrow(cropland_df), "rows |",
        length(unique(cropland_df$Country_ISO)), "countries\n")
  } else {
    stop("Cropland data not found. Download from FAOSTAT (item 6620) and save as cropland.csv")
  }
}

cropland_df <- cropland_df[
  !is.na(cropland_df$cropland_area_1000ha) &
    cropland_df$cropland_area_1000ha > 0, ]

# Collapse to exactly one row per Country_ISO x Year before the join below.
# The manual file (or, if it ever works again, the FAOSTAT package path) can
# contain multiple rows per country-year (e.g. several Item variants that
# all match the "Cropland" name filter, such as "Cropland" and "Cropland,
# irrigated"). left_join() requires a 1:1 or many:1 match, so this must be
# resolved before joining onto the crop panels.
n_before_dedup <- nrow(cropland_df)
cropland_df <- cropland_df %>%
  dplyr::group_by(Country_ISO, Year) %>%
  dplyr::summarise(cropland_area_1000ha = mean(cropland_area_1000ha, na.rm = TRUE),
                   .groups = "drop") %>%
  as.data.frame()
cat(sprintf("[OK] cropland_df deduplicated: %d -> %d rows (%d country-year pairs)\n",
            n_before_dedup, nrow(cropland_df), nrow(cropland_df)))

for (crop_name in names(crop_config)) {
  panelv4_path <- file.path(base_dir, paste0("panelv4_", crop_name, ".xlsx"))
  panelv5_path <- file.path(base_dir, paste0("panelv5_", crop_name, ".xlsx"))
  cat("---", toupper(crop_name), "---\n")
  if (!file.exists(panelv4_path)) { cat("  [ERROR] panelv4 missing\n\n"); next }
  
  panelv4  <- as.data.frame(readxl::read_excel(panelv4_path))
  year_col <- if ("Yil" %in% names(panelv4)) "Yil" else "Year"
  
  panelv5 <- panelv4 %>%
    dplyr::left_join(
      cropland_df,
      by = setNames(c("Country_ISO","Year"),
                    c("Country_ISO", year_col)),
      relationship = "many-to-one") %>%
    dplyr::mutate(
      # irr_ratio: equipped irrigation / cropland (preferred denominator)
      # Falls back to land_area if cropland is missing
      irr_ratio = dplyr::case_when(
        !is.na(cropland_area_1000ha) & cropland_area_1000ha > 0
        ~ pmin(equipped_irrig_1000ha / cropland_area_1000ha, 1),
        !is.na(land_area_1000ha) & land_area_1000ha > 0
        ~ pmin(equipped_irrig_1000ha / land_area_1000ha, 1),
        TRUE ~ NA_real_),
      irr_ratio_denom = dplyr::case_when(
        !is.na(cropland_area_1000ha) & cropland_area_1000ha > 0 ~ "cropland",
        !is.na(land_area_1000ha)     & land_area_1000ha > 0     ~ "land_area",
        TRUE ~ NA_character_))
  
  # Winsorise: if equipped > cropland -> cap at 0.95
  panelv5 <- panelv5 %>%
    dplyr::mutate(
      irr_ratio = ifelse(
        !is.na(equipped_irrig_1000ha) &
          !is.na(cropland_area_1000ha) &
          equipped_irrig_1000ha > cropland_area_1000ha,
        0.95, irr_ratio))
  
  writexl::write_xlsx(panelv5, panelv5_path)
  cat("  [SAVED]", basename(panelv5_path), "\n\n")
  rm(panelv4, panelv5); gc()
}


# ==============================================================================
# STEP 6 -- ARIDITY INDEX (AI = PRE_ann / PET_ann) + is_arid -> panelv6
#
# Definition follows UNEP (1997) Aridity Index classification:
#   AI < 0.05 : hyper-arid   | AI < 0.20 : arid
#   AI < 0.50 : semi-arid    | AI < 0.65 : dry sub-humid
# is_arid = 1 if AI < 0.50 (semi-arid and drier) -- the threshold commonly
# used as the risk boundary for reliable rainfed cereal production.
#
# PET data quality is checked BEFORE the index is used anywhere downstream:
#   (a) PET_ann should fall within a physically plausible range (0-3000 mm/yr)
#   (b) count of PET_ann == 0 or NA observations is reported
#   (c) the AI distribution is summarised (and can be plotted) to catch
#       skew or implausible spikes before trusting is_arid in the models
#
# TWO aridity variables are produced here, for two different purposes:
#   AI / is_arid            -- YEAR-VARYING (this country, this year's own
#                              PRE_ann/PET_ann). Reflects short-run wet/dry
#                              conditions, which overlaps heavily with PRE
#                              itself -- appropriate for within-year
#                              robustness checks, but NOT for classifying a
#                              country as structurally arid vs humid.
#   AI_baseline / is_arid_fixed -- TIME-INVARIANT (one fixed value per
#                              country, from the 1990-2000 baseline window,
#                              same fallback rule as the fixed-baseline weighting specification). This answers a
#                              genuinely different question: does the same
#                              temperature shock cause more damage in a
#                              structurally arid country than a structurally
#                              humid one? The fixed-aridity interaction specification (is_arid_fixed x TMX) uses
#                              this fixed version so it is not just
#                              re-measuring the precipitation x TMX interaction under another name.
# ==============================================================================

cat("\n", strrep("=", 60), "\nSTEP 6: Aridity Index + is_arid -> panelv6_*\n",
    strrep("=", 60), "\n\n")

AI_THRESHOLD <- 0.50   # semi-arid boundary, UNEP (1997)

# -- PET sanity check, run once on the pooled panel before per-crop processing --
cat("--- PET / AI sanity check (pooled across crops) ---\n")

pet_check_list <- list()
for (crop_name in names(crop_config)) {
  panelv5_path <- file.path(base_dir, paste0("panelv5_", crop_name, ".xlsx"))
  if (!file.exists(panelv5_path)) next
  df_tmp <- as.data.frame(readxl::read_excel(panelv5_path))
  if (!all(c("PRE_ann","PET_ann") %in% names(df_tmp))) next
  pet_check_list[[crop_name]] <- df_tmp[, c("Country_ISO","Yil","PRE_ann","PET_ann")]
}
pet_pool <- dplyr::bind_rows(pet_check_list) %>% dplyr::distinct()

n_total     <- nrow(pet_pool)
n_pet_zero  <- sum(pet_pool$PET_ann == 0, na.rm = TRUE)
n_pet_na    <- sum(is.na(pet_pool$PET_ann))
n_pet_out   <- sum(!is.na(pet_pool$PET_ann) &
                     (pet_pool$PET_ann < 0 | pet_pool$PET_ann > 3000))

cat(sprintf("  Total pooled country-year rows : %d\n", n_total))
cat(sprintf("  PET_ann == 0                   : %d (%.1f%%)\n",
            n_pet_zero, 100 * n_pet_zero / n_total))
cat(sprintf("  PET_ann == NA                  : %d (%.1f%%)\n",
            n_pet_na, 100 * n_pet_na / n_total))
cat(sprintf("  PET_ann outside [0, 3000] mm/yr: %d (%.1f%%)\n",
            n_pet_out, 100 * n_pet_out / n_total))

pet_pool$AI_check <- ifelse(pet_pool$PET_ann > 0,
                            pet_pool$PRE_ann / pet_pool$PET_ann, NA_real_)
cat("\n  AI (PRE_ann / PET_ann) summary:\n")
print(summary(pet_pool$AI_check))
cat(sprintf("  AI outside [0, 5] (implausible): %d rows\n",
            sum(!is.na(pet_pool$AI_check) &
                  (pet_pool$AI_check < 0 | pet_pool$AI_check > 5))))

cat("\n  [NOTE] If PET_ann == 0/NA rate or AI outlier rate is high (e.g. >10%),\n")
cat("         reconsider is_arid definition (e.g. fall back to PRE_ann < 400mm)\n")
cat("         before using is_arid or its interaction (is_arid x TMX) in models.\n\n")

rm(pet_check_list, pet_pool); gc()

# -- Helper: fixed (time-invariant) baseline AI per country --------------------
# Same baseline-window + fallback logic as the fixed-baseline production/area weights
# (Step 7 below), applied here to PRE_ann/PET_ann instead. Uses ratio of
# baseline-period means (not mean of yearly ratios), which is more robust
# to any single unusually wet/dry year within the baseline window.
compute_fixed_aridity <- function(df) {
  df %>%
    dplyr::group_by(Country_ISO) %>%
    dplyr::group_modify(function(sub, key) {
      in_window <- sub[sub$Yil >= BASELINE_START & sub$Yil <= BASELINE_END, ]
      
      if (nrow(in_window) >= 1) {
        used_years  <- sort(in_window$Yil)
        base_pre    <- mean(in_window$PRE_ann, na.rm = TRUE)
        base_pet    <- mean(in_window$PET_ann, na.rm = TRUE)
        is_fallback <- 0L
      } else {
        sub_sorted    <- sub[order(sub$Yil), ]
        take_n        <- min(BASELINE_LEN, nrow(sub_sorted))
        fallback_rows <- sub_sorted[seq_len(take_n), ]
        used_years    <- sort(fallback_rows$Yil)
        base_pre      <- mean(fallback_rows$PRE_ann, na.rm = TRUE)
        base_pet      <- mean(fallback_rows$PET_ann, na.rm = TRUE)
        is_fallback   <- 1L
      }
      
      ai_baseline <- if (!is.na(base_pet) && base_pet > 0) base_pre / base_pet else NA_real_
      period_label <- if (length(used_years) == 0) NA_character_ else
        paste0(min(used_years), "-", max(used_years))
      
      data.frame(
        AI_baseline                  = ai_baseline,
        is_arid_fixed                = ifelse(is.na(ai_baseline), NA_integer_,
                                              as.integer(ai_baseline < AI_THRESHOLD)),
        aridity_baseline_period_used = period_label,
        aridity_baseline_is_fallback = is_fallback,
        stringsAsFactors = FALSE)
    }) %>%
    dplyr::ungroup()
}

# -- Apply AI + is_arid (year-varying) and AI_baseline + is_arid_fixed ---------
# (time-invariant) to each crop panel ------------------------------------------

for (crop_name in names(crop_config)) {
  panelv5_path <- file.path(base_dir, paste0("panelv5_", crop_name, ".xlsx"))
  panelv6_path <- file.path(base_dir, paste0("panelv6_", crop_name, ".xlsx"))
  cat("---", toupper(crop_name), "---\n")
  if (!file.exists(panelv5_path)) { cat("  [ERROR] panelv5 missing\n\n"); next }
  
  panelv5 <- as.data.frame(readxl::read_excel(panelv5_path))
  if (!all(c("PRE_ann","PET_ann") %in% names(panelv5))) {
    cat("  [ERROR] PRE_ann/PET_ann column missing\n\n"); next
  }
  
  panelv5$irr_ratio <- pmin(panelv5$irr_ratio, 1.0)   # ensure cap at 1
  
  panelv6 <- panelv5 %>%
    dplyr::mutate(
      AI = dplyr::case_when(
        is.na(PET_ann) | PET_ann <= 0 ~ NA_real_,
        TRUE ~ PRE_ann / PET_ann),
      is_arid = dplyr::case_when(
        is.na(AI)        ~ NA_real_,
        AI < AI_THRESHOLD ~ 1,
        TRUE              ~ 0))
  
  fixed_aridity <- compute_fixed_aridity(panelv6[, c("Country_ISO","Yil","PRE_ann","PET_ann")])
  panelv6 <- panelv6 %>%
    dplyr::select(-dplyr::any_of(c("AI_baseline","is_arid_fixed",
                                   "aridity_baseline_period_used",
                                   "aridity_baseline_is_fallback"))) %>%
    dplyr::left_join(fixed_aridity, by = "Country_ISO")
  
  n_fallback_arid <- length(unique(
    panelv6$Country_ISO[panelv6$aridity_baseline_is_fallback == 1]))
  
  writexl::write_xlsx(panelv6, panelv6_path)
  cat("  [SAVED]", basename(panelv6_path),
      "| is_arid=1 (year-varying):", sum(panelv6$is_arid == 1, na.rm = TRUE), "rows",
      "| is_arid_fixed=1 (countries):",
      length(unique(panelv6$Country_ISO[panelv6$is_arid_fixed == 1])),
      "| baseline fallback used for", n_fallback_arid, "countries\n\n")
  rm(panelv5, panelv6, fixed_aridity); gc()
}


# ==============================================================================
# STEP 7 -- GDP PER CAPITA (World Bank WDI) -> panelv7 (final output)
#
# Variable: NY.GDP.PCAP.KD (constant 2015 USD per capita)
# Fallback: PPP-adjusted GDP if constant USD missing
# Interpolation: linear within-country interpolation for remaining gaps
# Also fixes WDI's backfilled early-year constant sequences and removes
# duplicate Country_ISO x Yil rows.
# ==============================================================================

cat("\n", strrep("=", 60), "\nSTEP 7: GDP per capita -> panelv7_* (final)\n",
    strrep("=", 60), "\n\n")

if (!requireNamespace("WDI", quietly = TRUE)) install.packages("WDI")
library(WDI)

cat("[*] Downloading GDP from World Bank WDI...\n")
gdp_raw <- WDI::WDI(
  indicator = "NY.GDP.PCAP.KD",
  country   = "all",
  start     = 1961, end = 2024,
  extra     = TRUE)

gdp_raw <- gdp_raw[
  !is.na(gdp_raw$iso3c) & gdp_raw$iso3c != "" &
    (is.na(gdp_raw$region) | gdp_raw$region != "Aggregates"), ]

cat("[OK] Downloaded. Range: min =",
    round(min(gdp_raw$NY.GDP.PCAP.KD, na.rm = TRUE), 0),
    "max =", round(max(gdp_raw$NY.GDP.PCAP.KD, na.rm = TRUE), 0),
    "USD\n")

iso_fix <- c("ROM" = "ROU", "ZAR" = "COD", "TMP" = "TLS",
             "YUG" = "SRB", "CSK" = "CZE")

gdp_clean <- data.frame(
  Country_ISO    = dplyr::recode(gdp_raw$iso3c, !!!iso_fix),
  Yil            = as.integer(gdp_raw$year),
  GDP_per_Capita = as.numeric(gdp_raw$NY.GDP.PCAP.KD),
  stringsAsFactors = FALSE) %>%
  dplyr::filter(!is.na(GDP_per_Capita), Yil >= 1961, Yil <= 2024) %>%
  dplyr::group_by(Country_ISO, Yil) %>%
  dplyr::summarise(GDP_per_Capita = mean(GDP_per_Capita, na.rm = TRUE),
                   .groups = "drop")

# Supplement with PPP-adjusted GDP where constant USD missing
gdp_ppp_raw <- tryCatch(
  WDI::WDI(indicator = "NY.GDP.PCAP.PP.KD",
           country = "all", start = 1961, end = 2024, extra = TRUE),
  error = function(e) NULL)

if (!is.null(gdp_ppp_raw)) {
  gdp_ppp_raw <- gdp_ppp_raw[
    !is.na(gdp_ppp_raw$iso3c) & gdp_ppp_raw$iso3c != "" &
      (is.na(gdp_ppp_raw$region) | gdp_ppp_raw$region != "Aggregates"), ]
  gdp_ppp <- data.frame(
    Country_ISO = gdp_ppp_raw$iso3c,
    Yil         = as.integer(gdp_ppp_raw$year),
    GDP_ppp     = as.numeric(gdp_ppp_raw$NY.GDP.PCAP.PP.KD),
    stringsAsFactors = FALSE) %>%
    dplyr::filter(!is.na(GDP_ppp), Yil >= 1961, Yil <= 2024) %>%
    dplyr::group_by(Country_ISO, Yil) %>%
    dplyr::summarise(GDP_ppp = mean(GDP_ppp, na.rm = TRUE), .groups = "drop")
  
  gdp_clean <- gdp_clean %>%
    dplyr::full_join(gdp_ppp, by = c("Country_ISO","Yil")) %>%
    dplyr::mutate(
      GDP_per_Capita = dplyr::case_when(
        !is.na(GDP_per_Capita) ~ GDP_per_Capita,
        !is.na(GDP_ppp)        ~ GDP_ppp,
        TRUE                   ~ NA_real_)) %>%
    dplyr::select(-GDP_ppp) %>%
    dplyr::filter(!is.na(GDP_per_Capita))
}

# Within-country linear interpolation to fill remaining gaps
# Within-country linear interpolation: fills GAPS between two real WDI
# observations. rule = 1 (NOT 2) deliberately leaves years OUTSIDE a
# country's genuinely observed WDI range as NA, rather than extrapolating
# the nearest real value forward/backward indefinitely. rule = 2 was found
# to silently hold GDP_per_Capita constant for a decade or more in
# countries with real WDI coverage gaps (e.g. Eritrea 2011-2024, Yemen
# 2018-2024 -- both conflict/data-collection-crisis periods), which is a
# pipeline-introduced artifact, not real WDI data. With rule = 1, GDP
# interpolation is confined to each country's genuinely observed WDI
# coverage window; no extrapolation beyond the last/first real observation.
full_grid <- expand.grid(
  Country_ISO = unique(gdp_clean$Country_ISO),
  Yil         = 1961:2024,
  stringsAsFactors = FALSE)

gdp_full <- full_grid %>%
  dplyr::left_join(gdp_clean, by = c("Country_ISO","Yil")) %>%
  dplyr::group_by(Country_ISO) %>%
  dplyr::mutate(
    n_observed = sum(!is.na(GDP_per_Capita)),
    GDP_per_Capita = ifelse(
      n_observed >= 2,
      approx(x    = Yil[!is.na(GDP_per_Capita)],
             y    = GDP_per_Capita[!is.na(GDP_per_Capita)],
             xout = Yil,
             rule = 1)$y,   # rule=1: NA outside observed range (no extrapolation)
      GDP_per_Capita)) %>%
  dplyr::ungroup() %>%
  dplyr::select(-n_observed) %>%
  dplyr::filter(!is.na(GDP_per_Capita))

cat("[OK] GDP full grid:", nrow(gdp_full), "rows |",
    length(unique(gdp_full$Country_ISO)), "countries\n")

# Function: remove backfilled GDP values (constant run at start of series)
remove_gdp_backfill <- function(df) {
  df %>%
    dplyr::group_by(Country_ISO) %>%
    dplyr::arrange(Yil, .by_group = TRUE) %>%
    dplyr::mutate(
      GDP_per_Capita = (function(x) {
        result   <- x
        non_na   <- which(!is.na(x))
        if (length(non_na) < 2) return(result)
        first_change <- NA_integer_
        for (k in 2:length(non_na)) {
          if (x[non_na[k]] != x[non_na[k - 1]]) {
            first_change <- non_na[k - 1]; break
          }
        }
        if (is.na(first_change)) { result[] <- NA; return(result) }
        if (first_change > 1) result[1:(first_change - 1)] <- NA
        result
      })(GDP_per_Capita)) %>%
    dplyr::ungroup()
}

for (crop_name in names(crop_config)) {
  panelv6_path <- file.path(base_dir, paste0("panelv6_", crop_name, ".xlsx"))
  panelv7_path <- file.path(base_dir, paste0("panelv7_", crop_name, ".xlsx"))
  cat("---", toupper(crop_name), "---\n")
  if (!file.exists(panelv6_path)) { cat("  [ERROR] panelv6 missing\n\n"); next }
  
  panelv6  <- as.data.frame(readxl::read_excel(panelv6_path))
  year_col <- if ("Yil" %in% names(panelv6)) "Yil" else "Year"
  
  # Drop old fallback GDP (may be incorrect), replace with WDI
  panelv6$GDP_per_Capita <- NULL
  
  panelv7 <- panelv6 %>%
    dplyr::left_join(
      gdp_full[, c("Country_ISO","Yil","GDP_per_Capita")],
      by = setNames(c("Country_ISO","Yil"),
                    c("Country_ISO", year_col)))
  
  panelv7$Yil <- as.integer(as.character(panelv7$Yil))
  panelv7 <- remove_gdp_backfill(panelv7)
  
  # Remove duplicate Country_ISO x Yil rows (keep row with most data)
  dup_check <- panelv7 %>%
    dplyr::group_by(Country_ISO, Yil) %>%
    dplyr::summarise(n = dplyr::n(), .groups = "drop") %>%
    dplyr::filter(n > 1)
  
  if (nrow(dup_check) > 0) {
    cat("  [", crop_name, "]", nrow(dup_check), "duplicate pairs -- removing\n")
    panelv7 <- panelv7 %>%
      dplyr::group_by(Country_ISO, Yil) %>%
      dplyr::arrange(
        dplyr::desc(!is.na(GDP_per_Capita)),
        dplyr::desc(!is.na(production_tonnes))) %>%
      dplyr::slice(1) %>%
      dplyr::ungroup()
  }
  
  # -- Fixed-baseline production/area weights -------------------------------
  # Same baseline-window + fallback logic as the fixed aridity
  # classification in Step 6 (BASELINE_START/END, same fallback rule):
  # a country's fixed-baseline weight is its own 1990-2000 average production/area,
  # or -- if it has no data at all in that window -- the average of its
  # own earliest available years instead. The resulting weight is fixed
  # (identical across all years of that country), documented via
  # baseline_period_used and baseline_is_fallback.
  baseline_vals <- panelv7 %>%
    dplyr::group_by(Country_ISO) %>%
    dplyr::group_modify(function(sub, key) {
      in_window <- sub[sub$Yil >= BASELINE_START & sub$Yil <= BASELINE_END, ]
      
      if (nrow(in_window) >= 1) {
        used_years  <- sort(in_window$Yil)
        base_prod   <- mean(in_window$production_tonnes, na.rm = TRUE)
        base_area   <- mean(in_window$area_harvested_ha, na.rm = TRUE)
        is_fallback <- 0L
      } else {
        sub_sorted    <- sub[order(sub$Yil), ]
        take_n        <- min(BASELINE_LEN, nrow(sub_sorted))
        fallback_rows <- sub_sorted[seq_len(take_n), ]
        used_years    <- sort(fallback_rows$Yil)
        base_prod     <- mean(fallback_rows$production_tonnes, na.rm = TRUE)
        base_area     <- mean(fallback_rows$area_harvested_ha, na.rm = TRUE)
        is_fallback   <- 1L
      }
      
      period_label <- if (length(used_years) == 0) NA_character_ else
        paste0(min(used_years), "-", max(used_years))
      
      data.frame(
        baseline_production_tonnes = base_prod,
        baseline_area_harvested_ha = base_area,
        baseline_period_used       = period_label,
        baseline_is_fallback       = is_fallback,
        stringsAsFactors = FALSE)
    }) %>%
    dplyr::ungroup()
  
  panelv7 <- panelv7 %>%
    dplyr::left_join(baseline_vals, by = "Country_ISO")
  
  n_fallback_baseline <- length(unique(
    panelv7$Country_ISO[panelv7$baseline_is_fallback == 1]))
  
  writexl::write_xlsx(panelv7, panelv7_path)
  cat("  [SAVED]", basename(panelv7_path),
      "| GDP filled:", sum(!is.na(panelv7$GDP_per_Capita)),
      "| GDP NA:", sum(is.na(panelv7$GDP_per_Capita)),
      "| Fixed-baseline fallback used for", n_fallback_baseline, "countries\n\n")
  rm(panelv6, panelv7, baseline_vals); gc()
}


