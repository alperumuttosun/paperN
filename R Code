# ---- Function: build target/pool/candidate selection for one crop, given (seed, N_pool) ----
# Same logic as Step 1, parameterized.
build_selection_for_config <- function(crop_name, seed, N_pool) {
  set.seed(seed)

  file_path <- file.path(data_dir, paste0("panelv7_", crop_name, ".xlsx"))
  if (!file.exists(file_path)) return(NULL)
  df <- read_excel(file_path)

  obs_count <- df %>%
    group_by(Country_ISO) %>%
    summarise(n_obs = sum(!is.na(yield_hg_per_ha)), .groups = "drop")
  eligible_countries <- obs_count %>% filter(n_obs >= 30) %>% pull(Country_ISO)
  df_elig <- df %>% filter(Country_ISO %in% eligible_countries)

  fingerprint <- df_elig %>%
    group_by(Country_ISO) %>%
    summarise(
      mean_TMX = mean(TMX_ann, na.rm = TRUE), sd_TMX = sd(TMX_ann, na.rm = TRUE),
      mean_PRE = mean(PRE_ann, na.rm = TRUE), sd_PRE = sd(PRE_ann, na.rm = TRUE),
      mean_GDP = mean(GDP_per_Capita, na.rm = TRUE), .groups = "drop"
    ) %>%
    filter(complete.cases(.))

  if (nrow(fingerprint) < N_pool + 10) return(NULL)   # not enough countries for this pool size + targets + candidates

  fp_scaled <- scale(fingerprint[, c("mean_TMX","sd_TMX","mean_PRE","sd_PRE","mean_GDP")])
  km <- kmeans(fp_scaled, centers = 5, nstart = 25)

  target_countries <- character(5)
  for (k in 1:5) {
    idx_in_cluster <- which(km$cluster == k)
    centroid <- km$centers[k, ]
    dists <- apply(fp_scaled[idx_in_cluster, , drop = FALSE], 1, function(row) sqrt(sum((row - centroid)^2)))
    target_countries[k] <- fingerprint$Country_ISO[idx_in_cluster[which.min(dists)]]
  }

  pool_candidates_fp <- fingerprint %>% filter(!Country_ISO %in% target_countries)
  pool_clusters <- km$cluster[match(pool_candidates_fp$Country_ISO, fingerprint$Country_ISO)]
  pool_countries <- character(0)
  n_per_cluster <- round(N_pool * table(pool_clusters) / length(pool_clusters))
  for (k in unique(pool_clusters)) {
    cluster_pool <- pool_candidates_fp$Country_ISO[pool_clusters == k]
    n_take <- min(n_per_cluster[as.character(k)], length(cluster_pool))
    pool_countries <- c(pool_countries, sample(cluster_pool, n_take))
  }
  if (length(pool_countries) > N_pool) {
    pool_countries <- sample(pool_countries, N_pool)
  } else if (length(pool_countries) < N_pool) {
    remaining <- setdiff(pool_candidates_fp$Country_ISO, pool_countries)
    if (length(remaining) >= N_pool - length(pool_countries)) {
      extra <- sample(remaining, N_pool - length(pool_countries))
      pool_countries <- c(pool_countries, extra)
    }
  }

  candidate_countries <- fingerprint$Country_ISO[!fingerprint$Country_ISO %in% c(target_countries, pool_countries)]

  list(df = df, target_countries = target_countries, pool_countries = pool_countries,
       candidate_countries = candidate_countries)
}

# ---- Function: compute NT prevalence for one crop, given a selection ----
compute_prevalence_for_crop <- function(crop_name, sel) {
  df <- sel$df %>% filter(complete.cases(select(., all_of(c("yield_hg_per_ha", feature_cols)))))
  pool_data <- df %>% filter(Country_ISO %in% sel$pool_countries)

  nt_lasso_vals <- c(); nt_xgb_vals <- c()

  for (t in sel$target_countries) {
    test_data <- df %>% filter(Country_ISO == t)
    if (nrow(test_data) < 5) next

    rmse_base_lasso <- fit_lasso_rmse(pool_data, test_data)
    if (RUN_XGB) rmse_base_xgb <- fit_xgb_rmse(pool_data, test_data)

    for (s in sel$candidate_countries) {
      cand_data <- df %>% filter(Country_ISO == s)
      if (nrow(cand_data) < 5) next
      train_plus_s <- bind_rows(pool_data, cand_data)

      rmse_add_lasso <- fit_lasso_rmse(train_plus_s, test_data)
      nt_lasso_vals <- c(nt_lasso_vals, rmse_base_lasso - rmse_add_lasso)

      if (RUN_XGB) {
        rmse_add_xgb <- fit_xgb_rmse(train_plus_s, test_data)
        nt_xgb_vals <- c(nt_xgb_vals, rmse_base_xgb - rmse_add_xgb)
      }
    }
  }

  data.frame(
    crop = crop_name,
    n_pairs = length(nt_lasso_vals),
    pct_negative_lasso = if (length(nt_lasso_vals) > 0) mean(nt_lasso_vals < 0) * 100 else NA,
    pct_negative_xgb    = if (RUN_XGB && length(nt_xgb_vals) > 0) mean(nt_xgb_vals < 0) * 100 else NA
  )
}

# ---- Run the full grid ----
all_config_results <- list()

for (i in seq_len(nrow(config_grid))) {
  N_pool <- config_grid$N_pool[i]
  seed   <- config_grid$seed[i]
  cat("\n=== Config", i, "/", nrow(config_grid), ": N_pool =", N_pool, ", seed =", seed, "===\n")

  crop_results <- list()
  for (crop_name in crops_all) {
    sel <- build_selection_for_config(crop_name, seed, N_pool)
    if (is.null(sel)) {
      cat("  ", crop_name, ": skipped (not enough eligible countries for N_pool =", N_pool, ")\n")
      next
    }
    res <- compute_prevalence_for_crop(crop_name, sel)
    crop_results[[crop_name]] <- res
    cat("  ", crop_name, ": pct_negative_lasso =", round(res$pct_negative_lasso, 1),
        if (RUN_XGB) paste0(", pct_negative_xgb = ", round(res$pct_negative_xgb, 1)) else "", "\n")
  }

  crop_tbl <- bind_rows(crop_results)
  if (nrow(crop_tbl) > 0) {
    # NOTE (bugfix): n_pairs must be summed LAST. dplyr::summarise() evaluates
    # arguments sequentially within one call, so if n_pairs = sum(n_pairs) came
    # before the weighted.mean() calls below, those calls would see the
    # already-overwritten (length-1) n_pairs instead of the original per-crop
    # vector, causing a "'x' and 'w' must have the same length" error.
    overall <- crop_tbl %>%
      summarise(
        crop = "ALL_CROPS_POOLED",
        pct_negative_lasso = weighted.mean(pct_negative_lasso, n_pairs, na.rm = TRUE),
        pct_negative_xgb    = if (RUN_XGB) weighted.mean(pct_negative_xgb, n_pairs, na.rm = TRUE) else NA,
        n_pairs = sum(n_pairs)
      )
    crop_tbl <- bind_rows(crop_tbl, overall)
  }
  crop_tbl$N_pool <- N_pool
  crop_tbl$seed   <- seed
  all_config_results[[i]] <- crop_tbl
}

