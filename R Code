# ---- 2. Build ORACLE features: pool composition, not just source-target distance ----
# For each (crop, target, candidate) row we add:
#  - pool_size:         size of the fixed pool S (mostly constant, kept for completeness)
#  - pool_heterogeneity: average pairwise distance WITHIN the pool (is S diverse or redundant?)
#  - cand_to_poolcentroid: distance from the candidate to the pool's centroid (is it a pool outlier?)
#  - cand_redundancy:    candidate's minimum distance to any single pool member (is it redundant with something already in S?)
#  - extrapolation_flag: 1 if the candidate is more extreme than the whole pool on any raw fingerprint dimension relative to target (rough proxy for "outside the pool's support")

build_oracle_features <- function(crop_name) {
  
  cat("\n----", toupper(crop_name), "----\n")
  
  file_path <- file.path(data_dir, paste0("panelv7_", crop_name, ".xlsx"))
  if (!file.exists(file_path)) {
    cat("WARNING:", file_path, "not found, skipping.\n")
    return(NULL)
  }
  
  df <- read_excel(file_path)
  sel_crop <- selection %>% filter(crop == crop_name)
  pool_countries <- sel_crop$country[sel_crop$role == "pool"]
  
  rich_vars <- c("TMX_ann", "TMN_ann", "DTR_ann", "PRE_ann", "PET_ann",
                 "VAP_ann", "CLD_ann", "WET_ann", "FRS_ann",
                 "GDP_per_Capita", "irr_ratio", "AI")
  
  fp <- df %>%
    filter(Country_ISO %in% sel_crop$country) %>%
    group_by(Country_ISO) %>%
    summarise(across(all_of(rich_vars), ~ mean(.x, na.rm = TRUE)), .groups = "drop") %>%
    filter(complete.cases(.))
  
  fp_mat <- as.matrix(fp[, rich_vars])
  rownames(fp_mat) <- fp$Country_ISO
  fp_scaled <- scale(fp_mat)
  rownames(fp_scaled) <- fp$Country_ISO
  cov_inv <- solve(cov(fp_scaled))
  
  euc <- function(a, b) sqrt(sum((fp_scaled[a, ] - fp_scaled[b, ])^2))          # plain Euclidean, used for pool diversity
  mah <- function(a, b) {                                                       # Mahalanobis, used for candidate-target/pool distances
    d <- fp_scaled[a, ] - fp_scaled[b, ]
    sqrt(as.numeric(t(d) %*% cov_inv %*% d))
  }
  
  pool_ok <- intersect(pool_countries, rownames(fp_scaled))
  
  # pool heterogeneity: mean pairwise Euclidean distance among pool members (one number, same for every row of this crop)
  pool_pairs <- combn(pool_ok, 2, simplify = FALSE)
  pool_heterogeneity <- mean(sapply(pool_pairs, function(p) euc(p[1], p[2])))
  
  pool_centroid <- colMeans(fp_scaled[pool_ok, , drop = FALSE])   # average fingerprint of the pool
  
  rows_crop <- feat %>% filter(crop == crop_name)
  
  out <- list()
  for (i in seq_len(nrow(rows_crop))) {
    s <- rows_crop$candidate[i]
    if (!(s %in% rownames(fp_scaled))) next
    
    dist_to_centroid <- sqrt(sum((fp_scaled[s, ] - pool_centroid)^2))          # how far the candidate sits from the pool's "center"
    min_dist_to_pool  <- min(sapply(pool_ok, function(p) euc(s, p)))            # how close the candidate is to its nearest pool member (redundancy proxy)
    
    # extrapolation flag: is the candidate more extreme than every pool member on at least one dimension, relative to target?
    target_vec <- fp_scaled[rows_crop$target[i], ]
    cand_vec   <- fp_scaled[s, ]
    pool_range <- apply(fp_scaled[pool_ok, , drop = FALSE], 2, range)
    outside <- any(cand_vec < pool_range[1, ] | cand_vec > pool_range[2, ])
    
    out[[length(out) + 1]] <- data.frame(
      crop = crop_name, target = rows_crop$target[i], candidate = s,
      pool_size = length(pool_ok),
      pool_heterogeneity = pool_heterogeneity,
      cand_to_poolcentroid = dist_to_centroid,
      cand_redundancy = min_dist_to_pool,
      extrapolation_flag = as.integer(outside)
    )
  }
  
  bind_rows(out)
}

