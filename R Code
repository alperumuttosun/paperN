# ---- Permutation test (stratified by crop) ----
# Shuffles labels ONLY within each crop's own test block, preserving each
# crop's true negative-transfer rate and the crop grouping structure, so
# that only 8 crops (rather than thousands of non-independent pairs) are
# implicitly treated as the independent unit.
# CORRECTED AFTER REVIEW: the original two-sided p-value compared each
# quantity's distance from the FIXED point 0.5 - i.e., it tested "how far
# from 0.5 is the observed AUROC, compared to how far from 0.5 permuted
# AUROCs get" - rather than the standard permutation-test question, "how
# extreme is the observed statistic relative to the null distribution's OWN
# realized values." These coincide only when the null distribution happens
# to be centered at 0.5. When it is not (Section 3.5 documents exactly this,
# with an NT_xgb null mean of 0.471 rather than 0.5), the old formula can
# give a badly misleading p-value - in our case, changing "not distinguishable
# from chance" into "distinguishable from chance" once corrected. We now
# compute the p-value from each permuted statistic's distance from the
# null distribution's own mean, with the standard +1/+1 continuity
# correction (Davison & Hinkley, 1997) so that a zero-exceedance result is
# reported as "< 1/(n_perm+1)" rather than an unjustified p = 0. We keep the
# old, uncorrected p-value alongside the new one for direct comparison.
permutation_test <- function(oof_pred, y_all, crop_vec, n_perm = 500) {
  observed <- auroc(oof_pred, y_all)
  perm_stats <- numeric(n_perm)
  for (p in 1:n_perm) {
    y_perm <- y_all
    for (c in unique(crop_vec)) {
      idx <- which(crop_vec == c)
      y_perm[idx] <- sample(y_all[idx])   # shuffle labels ONLY inside this crop's block
    }
    perm_stats[p] <- auroc(oof_pred, y_perm)
  }
  null_mean <- mean(perm_stats)
  p_value_old_uncorrected <- mean(abs(perm_stats - 0.5) >= abs(observed - 0.5))            # ORIGINAL (flawed) formula, kept for comparison only
  exceed <- sum(abs(perm_stats - null_mean) >= abs(observed - null_mean))
  p_value <- (exceed + 1) / (n_perm + 1)                                                    # CORRECTED formula: distance from the null's own mean, continuity-corrected
  list(observed = observed, p_value = p_value, p_value_old_uncorrected = p_value_old_uncorrected,
       perm_mean = null_mean, perm_sd = sd(perm_stats),
       perm_stats = perm_stats)   # keep the full null distribution, not just its mean/sd
}

