    pct_negative_NT_xgb      = mean(NT_xgb   < 0) * 100,          # same, for XGBoost
    spearman_D_vs_NT_lasso   = cor(D_mahalanobis, NT_lasso, method = "spearman"),
    spearman_D_vs_NT_xgb     = cor(D_mahalanobis, NT_xgb,   method = "spearman"),
    .groups = "drop"
  )

print(summary_tbl)

# ---- Save everything as Excel (no RDS) ----
out_path <- file.path(proj_dir, "negstep2_output.xlsx")

wb <- createWorkbook()
addWorksheet(wb, "pairwise_results")   # every (target, candidate) row with NT and distance
addWorksheet(wb, "summary_by_crop")    # per-crop Spearman correlation + % negative transfer

writeData(wb, "pairwise_results", all_results)
writeData(wb, "summary_by_crop", summary_tbl)

saveWorkbook(wb, out_path, overwrite = TRUE)

cat("\nStep 2 complete. Output saved to:\n", out_path, "\n")


