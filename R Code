# ---- Function: 5-fold CV AUROC (rank-based, no extra package needed) ----
auroc <- function(scores, labels) {
  n1 <- sum(labels == 1); n0 <- sum(labels == 0)
  if (n1 == 0 || n0 == 0) return(NA)
  r <- rank(scores)
  (sum(r[labels == 1]) - n1 * (n1 + 1) / 2) / (n1 * n0)
}

# ---- Function: 5-fold CV PR-AUC (trapezoidal integration over precision-recall points) ----
pr_auc <- function(scores, labels) {
  ord <- order(-scores)
  lab <- labels[ord]
  tp <- cumsum(lab)
  fp <- cumsum(1 - lab)
  precision <- tp / (tp + fp)
  recall    <- tp / sum(lab)
  auc <- 0; prev_r <- 0; prev_p <- 1
  for (i in seq_along(recall)) {
    auc <- auc + (recall[i] - prev_r) * (precision[i] + prev_p) / 2   # trapezoid area under this segment
    prev_r <- recall[i]; prev_p <- precision[i]
  }
  auc
}

# ---- Function: 5-fold CV for one NT column, return out-of-fold AUROC and PR-AUC ----
# for both the nonlinear (XGBoost) model and a simple linear (logistic) baseline.
#
# CORRECTED AFTER REVIEW (round 1): the original version used a RANDOM
# row-level fold split. Because many rows share the same target country
# (every candidate paired with that target) or the same candidate country
# (paired with many targets), random splitting can put highly similar rows
# into both the training and test fold, inflating apparent AUROC.
#
# CORRECTED AGAIN AFTER REVIEW (round 2): the first correction grouped folds
# by (crop, target) - e.g., "wheat_TUR" and "maize_TUR" were treated as two
# DIFFERENT groups. But the same country is sometimes selected as a target
# in more than one crop (empirically: 8 of 40 target slots, 11 slots overall,
# representing repeats among only 29 distinct countries out of 40 slots).
# Under (crop, target) grouping, a country like Turkey could appear as a
# target in the training fold via one crop (e.g., maize) while also
# appearing as a target in the test fold via a different crop (e.g., wheat).
# Since crop identity is itself a model feature, this is a real, if
# narrower, country-level leakage channel that (crop, target) grouping does
# NOT close. We now additionally support COUNTRY-level grouping - every row
# for a given target country, across ALL crops in which it is ever a
# target, is assigned to the same fold - which fully closes this channel.
# All three grouping schemes are computed and reported side by side so the
# effect of each correction can be seen directly.
#
# grouping = "random" (original, row-level) | "crop_target" (round-1 fix,
# grouped by (crop, target) pair) | "country" (round-2 fix, grouped by
# target country alone, closing the cross-crop repeat-target channel)
run_cv <- function(nt_col, x_all, grouping = c("country", "crop_target", "random"), include_nobs = FALSE) {
  grouping <- match.arg(grouping)

  y <- as.integer(feat[[nt_col]] < 0)     # 1 = negative transfer, 0 = not
  n <- nrow(feat)

  if (grouping == "country") {
    group_id <- feat$target                                           # group by country alone, ignoring which crop
    unique_groups <- unique(group_id)
    group_fold <- setNames(sample(rep(1:5, length.out = length(unique_groups))), unique_groups)
    folds <- group_fold[group_id]
  } else if (grouping == "crop_target") {
    group_id <- paste(feat$crop, feat$target, sep = "_")              # unique (crop, target) group id
    unique_groups <- unique(group_id)
    group_fold <- setNames(sample(rep(1:5, length.out = length(unique_groups))), unique_groups)
    folds <- group_fold[group_id]                                     # every row inherits its (crop,target) group's fold
  } else {
    folds <- sample(rep(1:5, length.out = n))                         # original behavior: random row-level split
  }

  oof_xgb    <- numeric(n)   # out-of-fold predicted probability, XGBoost
  oof_linear <- numeric(n)   # out-of-fold predicted probability, logistic regression baseline

  for (k in 1:5) {
    train_idx <- which(folds != k)
    test_idx  <- which(folds == k)

    # nonlinear model
    model_xgb <- xgboost(x = x_all[train_idx, ], y = factor(y[train_idx]),
                         nrounds = 100, max_depth = 3, learning_rate = 0.1,
                         objective = "binary:logistic")
    oof_xgb[test_idx] <- predict(model_xgb, x_all[test_idx, ])

    # simple linear baseline for comparison (does nonlinearity actually help?)
    x_dist_only <- x_all[, !(colnames(x_all) %in% colnames(crop_dummies)), drop = FALSE]
    train_df <- data.frame(y = y[train_idx], x_dist_only[train_idx, , drop = FALSE])
    test_df  <- data.frame(x_dist_only[test_idx, , drop = FALSE])
    model_lin <- glm(y ~ ., data = train_df, family = binomial())
    oof_linear[test_idx] <- predict(model_lin, newdata = test_df, type = "response")
  }

  data.frame(
    nt_column        = nt_col,
    cv_grouping       = grouping,
    includes_nobs     = include_nobs,
    auroc_xgb        = auroc(oof_xgb, y),
    pr_auc_xgb       = pr_auc(oof_xgb, y),
    auroc_linear     = auroc(oof_linear, y),
    pr_auc_linear    = pr_auc(oof_linear, y),
    pct_negative     = mean(y) * 100
  )
}

