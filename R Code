# ---- AUROC / PR-AUC helpers (same as previous steps) ----
auroc <- function(scores, labels) {
  n1 <- sum(labels == 1); n0 <- sum(labels == 0)
  if (n1 == 0 || n0 == 0) return(NA)
  r <- rank(scores)
  (sum(r[labels == 1]) - n1 * (n1 + 1) / 2) / (n1 * n0)
}
pr_auc <- function(scores, labels) {
  ord <- order(-scores)
  lab <- labels[ord]
  tp <- cumsum(lab); fp <- cumsum(1 - lab)
  precision <- tp / (tp + fp); recall <- tp / sum(lab)
  auc <- 0; prev_r <- 0; prev_p <- 1
  for (i in seq_along(recall)) {
    auc <- auc + (recall[i] - prev_r) * (precision[i] + prev_p) / 2
    prev_r <- recall[i]; prev_p <- precision[i]
  }
  auc
}

# ---- LOCO with delta_logme as the sole predictor ----
run_loco <- function(nt_col) {
  y_all <- as.integer(feat[[nt_col]] < 0)
  x_all <- as.matrix(feat[, feature_cols, drop = FALSE])
  crops_here <- unique(feat$crop)

  oof_pred <- numeric(nrow(feat))
  per_crop <- list()

  for (held_out in crops_here) {
    train_idx <- which(feat$crop != held_out)
    test_idx  <- which(feat$crop == held_out)
    if (length(test_idx) == 0) next

    model <- xgboost(x = x_all[train_idx, , drop = FALSE], y = factor(y_all[train_idx]),
                      nrounds = 100, max_depth = 3, learning_rate = 0.1,
                      objective = "binary:logistic")
    pred <- predict(model, x_all[test_idx, , drop = FALSE])
    oof_pred[test_idx] <- pred

    per_crop[[held_out]] <- data.frame(
      nt_column = nt_col, held_out_crop = held_out, n_test = length(test_idx),
      auroc = auroc(pred, y_all[test_idx]), pr_auc = pr_auc(pred, y_all[test_idx])
    )
  }

  list(
    per_crop = bind_rows(per_crop),
    oof_pred = oof_pred,
    y_all    = y_all
  )
}

# ---- Permutation test (stratified by crop) - identical protocol to step 7 ----
# CORRECTED AFTER REVIEW: same fix as Step 7's permutation_test() - the
# p-value is now computed from each permuted statistic's distance from the
# null distribution's OWN mean (continuity-corrected), not from a fixed
# distance-from-0.5 comparison, which is only valid when the null happens
# to be centered at 0.5. The old, uncorrected p-value is kept alongside for
# comparison. Step 10's null means (~0.50, ~0.498, per the original run)
# are already close to 0.5, so this correction is expected to have little
# numerical effect here - unlike in Step 7 - but we apply it for
# consistency and to confirm that expectation rather than assume it.
permutation_test <- function(oof_pred, y_all, crop_vec, n_perm = 500) {
  observed <- auroc(oof_pred, y_all)
  perm_stats <- numeric(n_perm)
  for (p in 1:n_perm) {
    y_perm <- y_all
    for (c in unique(crop_vec)) {
      idx <- which(crop_vec == c)
      y_perm[idx] <- sample(y_all[idx])
    }
    perm_stats[p] <- auroc(oof_pred, y_perm)
  }
  null_mean <- mean(perm_stats)
  p_value_old_uncorrected <- mean(abs(perm_stats - 0.5) >= abs(observed - 0.5))
  exceed <- sum(abs(perm_stats - null_mean) >= abs(observed - null_mean))
  p_value <- (exceed + 1) / (n_perm + 1)
  list(observed = observed, p_value = p_value, p_value_old_uncorrected = p_value_old_uncorrected,
       perm_mean = null_mean, perm_sd = sd(perm_stats), perm_stats = perm_stats)
}

# ---- Run everything ----
